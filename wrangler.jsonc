{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "figlock",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./site"
  },
  "routes": [
    { "pattern": "figlock.com", "custom_domain": true },
    { "pattern": "www.figlock.com", "custom_domain": true }
  ]
}
