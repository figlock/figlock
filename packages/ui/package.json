{
  "name": "@figlock/ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Shared Svelte 5 components on the FigLock design tokens (desktop and extension)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app.css": "./src/app.css"
  },
  "scripts": {
    "fmt": "prettier --write .",
    "lint": "prettier --check . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.9",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
