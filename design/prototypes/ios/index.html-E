<!doctype html>
<!--
  Open Design · OD Next handheld shell — iPhone (Dynamic Island, left silent/volume keys, right power key).
  Presentation shell for a phone-app prototype: keep the handset markup and
  CSS, put the product inside the APP CONTENT slot (`.phone-content`). The
  shell sets no typography, palette, spacing, or navigation for the app.
  Derived from the Open Design mobile-app template (Apache-2.0).
-->
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FigLock for iPhone - interactive prototype</title>
  <style>
/* OD-LAYOUT-PRIMITIVES v1 — structure only: display, flex/grid, overflow, wrapping, ratio, geometry.
   Put this @layer first; product CSS outside the layer wins ordinary layout rules.
   Native hidden and closed-dialog states take precedence over component display rules. */
@layer od-layout {
  [hidden]:not([hidden="until-found" i]) { display: none !important; }
  dialog:not([open]) { display: none !important; }

  :where(.od-stack,.od-row,.od-row-top,.od-cluster,.od-grid,.od-field,.od-stat,.od-cell,.od-tile) > :where(*) { min-width: 0; }

  /* containers */
  .od-stack   { display: flex; flex-direction: column; gap: var(--od-gap, 8px); }
  .od-row     { display: flex; align-items: center; gap: var(--od-gap, 8px); }
  .od-row-top { display: flex; align-items: flex-start; gap: var(--od-gap, 8px); }
  .od-cluster { display: flex; flex-wrap: wrap; align-items: center; gap: var(--od-gap, 8px); }
  .od-fill    { flex: 1 1 0; min-width: 0; }
  .od-fixed   { flex: none; }
  .od-grid    { display: grid; gap: var(--od-gap, 12px); grid-template-columns: repeat(var(--od-cols, 3), minmax(0, 1fr)); }

  /* stacked information: each piece is its own line — never sibling inline spans */
  .od-stat, .od-field, .od-cell { display: grid; gap: var(--od-gap, 2px); }
  :where(.od-stat,.od-field,.od-cell) > :where(*) { display: block; }
  .od-tile { display: grid; grid-template-rows: auto 1fr; }
  :where(.od-tile) > :where(*) { display: block; }

  /* media keeps its intrinsic ratio by default; never a distorted or cropped
     cover by accident. height:auto lets the ratio win over an <img height="…">
     attribute. Cropping to a uniform box is an explicit opt-in: set --od-ratio
     AND add .od-media-cover together (per the core rule, only where a crop is
     deliberate — tile thumbs, decorative fills — never on full-frame content). */
  .od-media { display: block; width: 100%; height: auto; aspect-ratio: var(--od-ratio, auto); }
  .od-media-cover { object-fit: cover; }

  /* functional inline SVG icons opt into bounded geometry; content SVGs keep their own */
  .od-icon { display: inline-block; inline-size: var(--od-icon-size, 1em); block-size: var(--od-icon-size, 1em); flex: none; }

  /* data text only — authored copy is rewritten to its budget instead */
  .od-truncate { display: block; max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .od-clamp-2, .od-clamp-3 { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
  .od-clamp-2 { -webkit-line-clamp: 2; }
  .od-clamp-3 { -webkit-line-clamp: 3; }
  .od-lines-2 { min-height: calc(2 * 1.4em); }   /* block-level reservation for a shared baseline */
  .od-nowrap  { white-space: nowrap; }           /* 数字+单位 · 价格+起 · 日期+星期 */
  .od-keep    { word-break: keep-all; overflow-wrap: anywhere; } /* CJK labels break at spaces / <wbr> first */

  /* screen skeleton (optional): bars take their own space, the middle scrolls — no padding guessed for chrome */
  .od-screen { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; height: 100%; }
  .od-scroll { overflow-y: auto; overscroll-behavior: contain; min-height: 0; }

  /* horizontal rail: the next item peeks at the edge; trailing room survives overflow */
  .od-rail { display: flex; gap: var(--od-gap, 8px); overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none;
             padding-inline: var(--od-rail-pad, 16px); scroll-padding-inline: var(--od-rail-pad, 16px); }
  .od-rail::-webkit-scrollbar { display: none; }
  :where(.od-rail) > :where(*) { flex: none; scroll-snap-align: start; }
  :where(.od-rail) > :where(:last-child) { margin-inline-end: var(--od-rail-pad, 16px); }

  .od-spacer { flex: none; visibility: hidden; pointer-events: none; }
  .od-touch  { min-width: 44px; min-height: 44px; }
}
:root [hidden]:where(:not([hidden="until-found" i])) { display: none; }
/* /OD-LAYOUT-PRIMITIVES v1 */

</style>
  <style>
    /* Native hidden remains authoritative over component flex/grid styles. */
    [hidden]:not([hidden="until-found" i]) { display: none !important; }

    :root {
      --phone-screen-width: 393px;
      --phone-screen-height: 852px;
      --phone-bezel: 12px;
      --phone-outer-radius: 60px;
      --phone-screen-radius: 48px;
      --phone-safe-top: 59px;
      --phone-safe-bottom: 34px;
      --phone-system-fg: #111214;
      --phone-screen-bg: #f7f7f8;
      --phone-stage-bg: #e9ebee;
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 32px;
      background:
        radial-gradient(circle at 50% 16%, rgba(255,255,255,.92), transparent 34%),
        var(--phone-stage-bg, #e9ebee);
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
      color: #17181a;
    }

    .phone-frame {
      position: relative;
      width: calc(var(--phone-screen-width, 393px) + var(--phone-bezel, 12px) * 2);
      height: calc(var(--phone-screen-height, 852px) + var(--phone-bezel, 12px) * 2);
      padding: var(--phone-bezel, 12px);
      border-radius: var(--phone-outer-radius, 60px);
      background:
        linear-gradient(145deg, rgba(255,255,255,.18), transparent 17%),
        linear-gradient(160deg, #3a3a3d 0%, #1d1d20 47%, #09090b 100%);
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.13),
        inset 0 0 0 2px rgba(0,0,0,.9),
        0 34px 70px -20px rgba(0,0,0,.55),
        0 12px 28px -12px rgba(0,0,0,.36);
      isolation: isolate;
    }

    .phone-frame::before,
    .phone-frame::after {
      content: "";
      position: absolute;
      z-index: -1;
      top: 102px;
      bottom: 102px;
      width: 3px;
      border-radius: 3px;
      background: linear-gradient(
        to bottom,
        transparent,
        rgba(255,255,255,.13) 12%,
        transparent 22%,
        transparent 78%,
        rgba(255,255,255,.08) 90%,
        transparent
      );
    }
    .phone-frame::before { left: -1px; }
    .phone-frame::after { right: -1px; }

    .hardware-button {
      position: absolute;
      width: 4px;
      border-radius: 3px;
      background: linear-gradient(90deg, #050506, #242428 58%, #08080a);
      box-shadow: inset 0 1px rgba(255,255,255,.08);
    }
    .hardware-button.silent { left: -3px; top: 175px; height: 34px; }
    .hardware-button.volume-up { left: -3px; top: 225px; height: 62px; }
    .hardware-button.volume-down { left: -3px; top: 299px; height: 62px; }
    .hardware-button.power { right: -3px; top: 252px; height: 104px; }

    .phone-screen {
      position: relative;
      width: var(--phone-screen-width, 393px);
      height: var(--phone-screen-height, 852px);
      overflow: hidden;
      border-radius: var(--phone-screen-radius, 48px);
      background: var(--phone-screen-bg, #f7f7f8);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
    }

    .phone-content {
      position: absolute;
      inset: 0;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-top: var(--phone-safe-top, 59px);
      padding-bottom: var(--phone-safe-bottom, 34px);
      background: var(--phone-screen-bg, #f7f7f8);
    }
    .phone-content::-webkit-scrollbar { display: none; }

    .dynamic-island {
      position: absolute;
      z-index: 20;
      top: 11px;
      left: 50%;
      width: 126px;
      height: 37px;
      transform: translateX(-50%);
      border-radius: 999px;
      background: #000;
      box-shadow: inset 0 -1px 1px rgba(255,255,255,.05);
      pointer-events: none;
    }

    .status-bar {
      position: absolute;
      z-index: 15;
      top: 0;
      left: 0;
      right: 0;
      height: var(--phone-safe-top, 59px);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 18px 27px 0;
      color: var(--phone-system-fg, #111214);
      font-size: 15px;
      font-weight: 650;
      letter-spacing: -.01em;
      pointer-events: none;
    }
    .status-icons { display: inline-flex; align-items: center; gap: 6px; }
    .status-icons svg { display: block; width: 17px; height: 11px; fill: currentColor; }
    .status-icons .battery { width: 25px; }

    .home-indicator {
      position: absolute;
      z-index: 20;
      left: 50%;
      bottom: 8px;
      width: 134px;
      height: 5px;
      transform: translateX(-50%);
      border-radius: 999px;
      background: var(--phone-system-fg, #111214);
      opacity: .9;
      pointer-events: none;
    }

    /* Sample content exists only to make the shell previewable. Replace it. */
    .sample-app { min-height: 100%; padding: 18px 20px 32px; background: #f7f7f8; }
    .sample-app h1 { margin: 0; font-size: 30px; letter-spacing: -.035em; }
    .sample-app p { margin: 8px 0 24px; color: #686b71; line-height: 1.5; }
    .sample-card {
      padding: 18px;
      border: 1px solid #e3e4e7;
      border-radius: 20px;
      background: #fff;
      box-shadow: 0 8px 24px rgba(20,22,26,.06);
    }
    .sample-card + .sample-card { margin-top: 12px; }

    /* Presentation scaling: keep the whole handset visible on short viewports. */
    @media (max-height: 939px) { .phone-frame { zoom: 0.9; } }
    @media (max-height: 851px) { .phone-frame { zoom: 0.82; } }
    @media (max-height: 781px) { .phone-frame { zoom: 0.74; } }
    @media (max-height: 711px) { .phone-frame { zoom: 0.66; } }
    /* Narrow viewports: the handset chrome collapses and the screen fills the
       viewport, so the app behaves like a real phone page instead of
       scrolling sideways. */
    @media (max-width: 480px) {
      body { padding: 0; display: block; }
      .phone-frame { width: 100%; height: 100dvh; padding: 0; border-radius: 0; background: none; box-shadow: none; zoom: 1; }
      .phone-frame::before, .phone-frame::after, .hardware-button { display: none; }
      .phone-screen { width: 100%; height: 100%; border-radius: 0; }
    }
  </style>
  <style>
/* FigLock design tokens (design/tokens.css), inlined unchanged */
/*
 * FigLock design tokens (FIG-22). Source of truth for web, desktop and extension (packages/ui).
 * iOS and Android map the same names to SwiftUI and Compose; see design/DESIGN.md.
 * Contrast ratios of every text/background pair are listed in DESIGN.md and meet WCAG 2.2 AA.
 * Never reference the raw palette (--brand-*, --neutral-*) from components; use the semantic tokens.
 */

:root {
  /* ---- Raw palette: brand blue ---- */
  --brand-50: #eef1ff;
  --brand-200: #b8c4ff;
  --brand-300: #9fb0ff;
  --brand-500: #3b5afe;
  --brand-600: #2c46d6;
  --brand-900: #161d4a;

  /* ---- Raw palette: warm neutral ---- */
  --neutral-0: #ffffff;
  --neutral-50: #faf9f9;
  --neutral-100: #f2f0f1;
  --neutral-200: #e5e2e4;
  --neutral-300: #cfcacd;
  --neutral-400: #a29ca0;
  --neutral-500: #78727a;
  --neutral-600: #5a555c;
  --neutral-700: #3f3b41;
  --neutral-800: #2a272c;
  --neutral-900: #1b191d;
  --neutral-950: #121114;

  /* ---- Typography ---- */
  --font-sans: "Figtree", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;

  --text-xs: 0.75rem; /* 12 */
  --text-sm: 0.8125rem; /* 13 */
  --text-base: 0.875rem; /* 14, dense desktop UI default */
  --text-md: 1rem; /* 16, mobile and web body */
  --text-lg: 1.125rem; /* 18 */
  --text-xl: 1.25rem; /* 20 */
  --text-2xl: 1.5rem; /* 24 */
  --text-3xl: 1.875rem; /* 30 */
  --text-4xl: 2.25rem; /* 36 */

  --leading-tight: 1.2;
  --leading-snug: 1.35;
  --leading-normal: 1.5;

  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  --tracking-tight: -0.01em;
  --tracking-normal: 0;
  --tracking-wide: 0.04em; /* small caps labels */

  /* ---- Spacing: 4 px grid ---- */
  --space-0: 0;
  --space-1: 0.25rem; /* 4 */
  --space-2: 0.5rem; /* 8 */
  --space-3: 0.75rem; /* 12 */
  --space-4: 1rem; /* 16 */
  --space-5: 1.25rem; /* 20 */
  --space-6: 1.5rem; /* 24 */
  --space-8: 2rem; /* 32 */
  --space-10: 2.5rem; /* 40 */
  --space-12: 3rem; /* 48 */
  --space-16: 4rem; /* 64 */

  /* ---- Radius ---- */
  --radius-xs: 6px;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --radius-full: 9999px;

  /* ---- Sizing ---- */
  --control-height-sm: 28px;
  --control-height-md: 36px;
  --control-height-lg: 44px; /* minimum touch target on iOS; Android uses 48 (--touch-target-android) */
  --touch-target-android: 48px;
  --focus-ring-width: 2px;
  --focus-ring-offset: 2px;

  /* ---- Motion ---- */
  --duration-instant: 80ms;
  --duration-fast: 120ms;
  --duration-base: 200ms;
  --duration-slow: 320ms;
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --ease-enter: cubic-bezier(0, 0, 0, 1);
  --ease-exit: cubic-bezier(0.3, 0, 1, 1);

  /* ---- Layering ---- */
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-overlay: 300;
  --z-modal: 400;
  --z-toast: 500;
}

/* ---- Semantic colors: light (default) ---- */
:root,
:root[data-theme="light"] {
  color-scheme: light;

  --color-bg: #faf9f9;
  --color-surface: #ffffff;
  --color-surface-sunken: #f2f0f1;
  --color-surface-raised: #ffffff;

  --color-text: #1b191d;
  --color-text-secondary: #5a555c;
  --color-text-tertiary: #6b656d;
  --color-text-on-primary: #ffffff;
  --color-text-link: #3b5afe;

  --color-border: #e5e2e4;
  --color-border-strong: #8d878f; /* inputs and controls: 3:1 against bg */

  --color-primary: #3b5afe;
  --color-primary-hover: #2c46d6;
  --color-primary-subtle: #eef1ff;

  --color-agent: #0f6e7a; /* everything about an AI agent asking for access */
  --color-agent-subtle: #e6f3f5;

  --color-success: #1e7a4d;
  --color-success-subtle: #e8f5ee;
  --color-warning: #8a5a00;
  --color-warning-subtle: #fbf1dc;
  --color-danger: #b3261e;
  --color-danger-subtle: #fdecea;

  --color-focus: #3b5afe;
  --color-overlay: rgb(27 25 29 / 0.5);

  --shadow-sm: 0 1px 2px rgb(27 25 29 / 0.08);
  --shadow-md: 0 4px 12px rgb(27 25 29 / 0.1);
  --shadow-lg: 0 12px 32px rgb(27 25 29 / 0.16);
}

/* ---- Semantic colors: dark ---- */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;

    --color-bg: #121114;
    --color-surface: #1b191d;
    --color-surface-sunken: #0d0c0e;
    --color-surface-raised: #242127;

    --color-text: #f2f0f1;
    --color-text-secondary: #c4bfc3;
    --color-text-tertiary: #a29ca0;
    --color-text-on-primary: #121114;
    --color-text-link: #9fb0ff;

    --color-border: #2a272c;
    --color-border-strong: #6f6972;

    --color-primary: #9fb0ff;
    --color-primary-hover: #b8c4ff;
    --color-primary-subtle: #161d4a;

    --color-agent: #5cc8d6;
    --color-agent-subtle: #0f2b30;

    --color-success: #5cd08f;
    --color-success-subtle: #0f2a1b;
    --color-warning: #e8b04a;
    --color-warning-subtle: #2e2208;
    --color-danger: #ff8a80;
    --color-danger-subtle: #3a1512;

    --color-focus: #9fb0ff;
    --color-overlay: rgb(0 0 0 / 0.6);

    --shadow-sm: 0 1px 2px rgb(0 0 0 / 0.4);
    --shadow-md: 0 4px 12px rgb(0 0 0 / 0.5);
    --shadow-lg: 0 12px 32px rgb(0 0 0 / 0.6);
  }
}

:root[data-theme="dark"] {
  color-scheme: dark;

  --color-bg: #121114;
  --color-surface: #1b191d;
  --color-surface-sunken: #0d0c0e;
  --color-surface-raised: #242127;

  --color-text: #f2f0f1;
  --color-text-secondary: #c4bfc3;
  --color-text-tertiary: #a29ca0;
  --color-text-on-primary: #121114;
  --color-text-link: #9fb0ff;

  --color-border: #2a272c;
  --color-border-strong: #6f6972;

  --color-primary: #9fb0ff;
  --color-primary-hover: #b8c4ff;
  --color-primary-subtle: #161d4a;

  --color-agent: #5cc8d6;
  --color-agent-subtle: #0f2b30;

  --color-success: #5cd08f;
  --color-success-subtle: #0f2a1b;
  --color-warning: #e8b04a;
  --color-warning-subtle: #2e2208;
  --color-danger: #ff8a80;
  --color-danger-subtle: #3a1512;

  --color-focus: #9fb0ff;
  --color-overlay: rgb(0 0 0 / 0.6);

  --shadow-sm: 0 1px 2px rgb(0 0 0 / 0.4);
  --shadow-md: 0 4px 12px rgb(0 0 0 / 0.5);
  --shadow-lg: 0 12px 32px rgb(0 0 0 / 0.6);
}

/* ---- Reduced motion: keep state changes, drop movement ---- */
@media (prefers-reduced-motion: reduce) {
  :root {
    --duration-instant: 0ms;
    --duration-fast: 0ms;
    --duration-base: 0ms;
    --duration-slow: 0ms;
  }
}

/* ===== Product tokens (kept apart from the handset shell block) ===== */
:root {
  --phone-screen-width: 390px;
  --phone-screen-height: 844px;
  --phone-screen-bg: var(--color-bg);
  --phone-system-fg: var(--color-text);
  --phone-stage-bg: var(--color-surface-sunken);
}
:root {
  --dt: 1;
  --font-ios: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro", system-ui, sans-serif;
  --t-large: calc(var(--text-4xl) * min(var(--dt), 1.6));
  --t-title: calc(var(--text-xl) * var(--dt));
  --t-body: calc(var(--text-md) * var(--dt));
  --t-sub: calc(var(--text-base) * var(--dt));
  --t-foot: calc(var(--text-sm) * var(--dt));
  --t-cap: calc(var(--text-xs) * var(--dt));
  --t-chrome: calc(var(--text-md) * min(var(--dt), 1.3));
  --t-tab: calc(var(--text-xs) * min(var(--dt), 1.3));
  --tabbar-h: 49px;
  --hair: 1px;
}
html[data-dt="large"] { --dt: 1.25; }
html[data-dt="ax5"] { --dt: 2; }
html.rm { --duration-instant: 0ms; --duration-fast: 0ms; --duration-base: 0ms; --duration-slow: 0ms; }
html.rm *, html.rm *::before, html.rm *::after { animation: none !important; }

/* ===== Stage (prototype controls, not app UI) ===== */
body { display: flex; align-items: center; justify-content: center; gap: var(--space-8); background: var(--phone-stage-bg); color: var(--color-text); font-family: var(--font-ios); }
.stage-panel { width: 300px; flex: none; align-self: center; max-height: calc(100dvh - 48px); overflow-y: auto; padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); font-size: var(--text-base); color: var(--color-text); display: grid; gap: var(--space-4); }
.stage-panel h1 { margin: 0; font-size: var(--text-lg); font-weight: 600; }
.stage-panel p { margin: 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: var(--leading-normal); }
.stage-panel label, .stage-panel .pl { display: block; font-size: var(--text-sm); font-weight: 500; color: var(--color-text-secondary); margin-bottom: var(--space-1); }
.stage-panel select { width: 100%; min-height: 44px; padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--color-border-strong); background: var(--color-surface); color: var(--color-text); font: inherit; }
.pnav { display: flex; gap: var(--space-2); margin-top: var(--space-2); }
.pbtn, .pseg button { min-height: 44px; padding: 0 var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--color-border-strong); background: var(--color-surface); color: var(--color-text); font: inherit; font-size: var(--text-sm); cursor: pointer; }
.pnav .pbtn { flex: 1; }
.pseg { display: flex; gap: var(--space-1); }
.pseg button { flex: 1; padding: 0 var(--space-2); }
.pseg button[aria-pressed="true"] { background: var(--color-primary); color: var(--color-text-on-primary); border-color: var(--color-primary); font-weight: 600; }
.phint { padding: var(--space-3); border-radius: var(--radius-sm); background: var(--color-surface-sunken); }
.phint strong { color: var(--color-text); }
.pcur { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-tertiary); }
@media (max-width: 1000px) { body { flex-direction: column; } .stage-panel { max-height: none; width: min(390px, 100%); } }
@media (max-width: 480px) { .stage-panel { display: none; } }

/* ===== Shell tweaks ===== */
.phone-content { padding: 0; overflow: hidden; background: var(--color-bg); }
#app { position: absolute; inset: 0; font-family: var(--font-ios); font-size: var(--t-body); line-height: var(--leading-snug); color: var(--color-text); }
.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
button { font: inherit; color: inherit; }
:where(button, input, textarea, select, a, [tabindex]):focus-visible { outline: var(--focus-ring-width) solid var(--color-focus); outline-offset: var(--focus-ring-offset); }
.mono { font-family: var(--font-mono); font-variant-ligatures: none; font-feature-settings: "liga" 0, "calt" 0; letter-spacing: 0; }

/* ===== Screen frame ===== */
.screen { height: 100%; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; background: var(--color-bg); }
.screen.bare { display: block; position: relative; overflow: hidden; }
.nav { padding-top: var(--phone-safe-top); background: var(--color-bg); border-bottom: 1px solid transparent; }
.nav.collapsed { border-bottom-color: var(--color-border); }
.nav-bar { display: grid; grid-template-columns: minmax(44px, 1fr) auto minmax(44px, 1fr); align-items: center; min-height: 44px; padding: 0 var(--space-2); gap: var(--space-1); }
.nav-title { font-size: var(--t-chrome); font-weight: 600; opacity: 0; text-align: center; max-width: 190px; }
.nav.collapsed .nav-title, .nav.always .nav-title { opacity: 1; }
.nav-left { justify-self: start; display: flex; }
.nav-right { justify-self: end; display: flex; }
.navbtn { min-height: 44px; min-width: 44px; padding: 0 var(--space-2); display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1); background: none; border: 0; border-radius: var(--radius-sm); color: var(--color-text-link); font-size: var(--t-chrome); cursor: pointer; white-space: nowrap; }
.navbtn.bold { font-weight: 600; }
.navbtn[disabled] { color: var(--color-text-tertiary); cursor: not-allowed; }
.scroll { overflow-y: auto; overscroll-behavior: contain; min-height: 0; padding: 0 var(--space-4) calc(var(--phone-safe-bottom) + var(--space-4)); scrollbar-width: none; }
.scroll::-webkit-scrollbar { display: none; }
.hastab .scroll { padding-bottom: var(--space-6); }
.hasfoot .scroll { padding-bottom: var(--space-6); }
.lt { margin: var(--space-2) 0 var(--space-2); font-size: var(--t-large); line-height: var(--leading-tight); font-weight: 700; letter-spacing: var(--tracking-tight); overflow-wrap: anywhere; }
.lt2 { margin: 0; font-size: var(--t-title); line-height: var(--leading-snug); font-weight: 600; overflow-wrap: anywhere; }
.sub { margin: 0 0 var(--space-4); color: var(--color-text-secondary); font-size: var(--t-body); line-height: var(--leading-normal); }
.step { margin: 0 0 var(--space-1); font-size: var(--t-foot); color: var(--color-text-secondary); font-weight: 500; }
.foot { padding: var(--space-3) var(--space-4) calc(var(--phone-safe-bottom) + var(--space-2)); background: var(--color-bg); display: grid; gap: var(--space-2); border-top: 1px solid var(--color-border); }
.stack { display: grid; gap: var(--space-3); }
.stack4 { display: grid; gap: var(--space-4); }
.hero { display: grid; gap: var(--space-2); justify-items: start; padding-top: var(--space-4); }
.center { text-align: center; justify-items: center; }
.ax5 .od-truncate { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }

/* ===== Tab bar ===== */
.tabbar { display: grid; grid-template-columns: repeat(3, 1fr); background: var(--color-surface); border-top: 1px solid var(--color-border); padding: var(--space-1) var(--space-2) calc(var(--phone-safe-bottom) - var(--space-2)); }
.tab { position: relative; min-height: var(--tabbar-h); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; background: none; border: 0; border-radius: var(--radius-sm); color: var(--color-text-secondary); font-size: var(--t-tab); font-weight: 500; cursor: pointer; }
.tab.on { color: var(--color-primary); font-weight: 600; }
.tab .badge-n { position: absolute; top: 2px; left: calc(50% + 8px); min-width: 18px; height: 18px; padding: 0 5px; border-radius: var(--radius-full); background: var(--color-agent); color: var(--color-text-on-primary); font-size: var(--text-xs); font-weight: 700; display: grid; place-items: center; }

/* ===== Groups, cells ===== */
.group { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; }
.group > * + * { border-top: 1px solid var(--color-border); }
.ghead { margin: var(--space-6) 0 var(--space-2); padding: 0 var(--space-4); font-size: var(--t-foot); font-weight: 500; color: var(--color-text-secondary); }
.gfoot { margin: var(--space-2) 0 0; padding: 0 var(--space-4); font-size: var(--t-foot); color: var(--color-text-secondary); line-height: var(--leading-normal); }
.cell { display: flex; align-items: center; gap: var(--space-3); width: 100%; min-height: 44px; padding: var(--space-3) var(--space-4); background: none; border: 0; text-align: left; color: var(--color-text); cursor: pointer; }
.cell .grow { flex: 1 1 0; min-width: 0; display: grid; gap: 2px; }
.cell .t { font-size: var(--t-body); font-weight: 400; }
.cell .t.b { font-weight: 600; }
.cell .s { font-size: var(--t-foot); color: var(--color-text-secondary); line-height: var(--leading-snug); }
.cell .v { flex: none; color: var(--color-text-secondary); font-size: var(--t-body); max-width: 50%; text-align: right; overflow-wrap: anywhere; }
.cell .chev { color: var(--color-text-tertiary); }
.cell.danger .t { color: var(--color-danger); }
.cell[disabled] { cursor: default; }
.tile { flex: none; width: 40px; height: 40px; border-radius: var(--radius-sm); display: grid; place-items: center; background: var(--color-primary-subtle); color: var(--color-primary); }
.tile.agent { background: var(--color-agent-subtle); color: var(--color-agent); }
.tile.warn { background: var(--color-warning-subtle); color: var(--color-warning); }
.tile.ok { background: var(--color-success-subtle); color: var(--color-success); }
.tile.bad { background: var(--color-danger-subtle); color: var(--color-danger); }
.tile.big { width: 56px; height: 56px; border-radius: var(--radius-md); }
.tile.xl { width: 72px; height: 72px; border-radius: var(--radius-lg); }
.logo { display: block; width: var(--logo, 64px); height: var(--logo, 64px); flex: none; border-radius: 22%; overflow: hidden; }
.logo svg { display: block; width: 100%; height: 100%; }
.i-agent { color: var(--color-agent); }
.i-ok { color: var(--color-success); }
.i-warn { color: var(--color-warning); }
.i-bad { color: var(--color-danger); }

/* ===== Buttons ===== */
.btn { display: flex; align-items: center; justify-content: center; gap: var(--space-2); width: 100%; min-height: 50px; padding: var(--space-3) var(--space-4); border: 0; border-radius: var(--radius-md); background: var(--color-primary); color: var(--color-text-on-primary); font-size: var(--t-body); font-weight: 600; text-align: center; cursor: pointer; line-height: var(--leading-snug); }
.btn:active { background: var(--color-primary-hover); }
@media (hover: hover) { .btn:hover { background: var(--color-primary-hover); } }
.btn.secondary { background: var(--color-surface); color: var(--color-text-link); box-shadow: inset 0 0 0 1px var(--color-border-strong); }
.btn.plain { background: none; color: var(--color-text-link); box-shadow: none; }
.btn.danger { background: var(--color-danger); color: var(--color-text-on-primary); }
.btn.agent { background: var(--color-agent); color: var(--color-text-on-primary); }
.btn.warn { background: var(--color-warning); color: var(--color-text-on-primary); }
.btn.dangerplain { background: none; color: var(--color-danger); box-shadow: none; }
.btn[disabled] { background: var(--color-surface-sunken); color: var(--color-text-tertiary); box-shadow: inset 0 0 0 1px var(--color-border); cursor: not-allowed; }
.btn.loading .od-icon { animation: spin 1s linear infinite; }
.btn-sm { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-4); border-radius: var(--radius-sm); border: 0; background: var(--color-primary-subtle); color: var(--color-text-link); font-size: var(--t-sub); font-weight: 600; cursor: pointer; }
.btn-sm.danger { color: var(--color-danger); background: var(--color-danger-subtle); }
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== Forms ===== */
.fld { display: grid; gap: var(--space-2); }
.label { font-size: var(--t-foot); font-weight: 500; color: var(--color-text-secondary); }
.req { color: var(--color-text-secondary); font-weight: 400; }
.input { width: 100%; min-height: 48px; padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text); font-size: var(--t-body); line-height: var(--leading-snug); }
textarea.input { min-height: 96px; resize: vertical; }
.input.err { border-color: var(--color-danger); border-width: 2px; }
.input[disabled] { background: var(--color-surface-sunken); color: var(--color-text-tertiary); cursor: not-allowed; }
.hint { margin: 0; font-size: var(--t-foot); color: var(--color-text-secondary); line-height: var(--leading-snug); }
.errmsg { display: flex; gap: var(--space-2); align-items: flex-start; margin: 0; font-size: var(--t-foot); color: var(--color-danger); line-height: var(--leading-snug); }
.errmsg .od-icon { margin-top: 2px; }
.pwrow { display: flex; gap: var(--space-2); }
.pwrow .input { flex: 1 1 0; min-width: 0; }
.iconbtn { flex: none; width: 48px; min-height: 48px; display: grid; place-items: center; border-radius: var(--radius-sm); border: 1px solid var(--color-border-strong); background: var(--color-surface); color: var(--color-text-link); cursor: pointer; }
.seg { display: flex; padding: 2px; gap: 2px; background: var(--color-surface-sunken); border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
.seg button { flex: 1; min-height: 44px; padding: 0 var(--space-2); border: 0; border-radius: var(--radius-xs); background: none; color: var(--color-text-secondary); font-size: var(--t-sub); font-weight: 500; cursor: pointer; }
.seg button.on { background: var(--color-surface-raised); color: var(--color-text); font-weight: 600; box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--color-border-strong); }
.switch { flex: none; position: relative; width: 51px; height: 31px; border-radius: var(--radius-full); border: 0; background: var(--color-border-strong); cursor: pointer; padding: 0; }
.switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 27px; height: 27px; border-radius: var(--radius-full); background: var(--color-surface); box-shadow: var(--shadow-sm); transition: transform var(--duration-base) var(--ease-standard); }
.switch[aria-checked="true"] { background: var(--color-success); }
.switch[aria-checked="true"]::after { transform: translateX(20px); }
.cellswitch { position: relative; }
.range { width: 100%; min-height: 44px; accent-color: var(--color-primary); }
.meter { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-1); }
.meter span { height: 4px; border-radius: var(--radius-full); background: var(--color-border); }
.meter.weak span:nth-child(1) { background: var(--color-danger); }
.meter.ok span:nth-child(-n+2) { background: var(--color-warning); }
.meter.strong span { background: var(--color-success); }
.mtxt { display: flex; align-items: center; gap: var(--space-2); font-size: var(--t-foot); font-weight: 600; }

/* ===== Chips, badges, notices ===== */
.badge { display: inline-flex; align-items: center; gap: var(--space-1); padding: 2px var(--space-2); border-radius: var(--radius-xs); background: var(--color-primary-subtle); color: var(--color-text-link); font-size: var(--t-cap); font-weight: 600; line-height: var(--leading-snug); }
.badge.agent { background: var(--color-agent-subtle); color: var(--color-agent); }
.badge.ok { background: var(--color-success-subtle); color: var(--color-success); }
.badge.warn { background: var(--color-warning-subtle); color: var(--color-warning); }
.badge.bad { background: var(--color-danger-subtle); color: var(--color-danger); }
.chip { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-4); border-radius: var(--radius-sm); border: 1px solid var(--color-border-strong); background: var(--color-surface); color: var(--color-text); font-size: var(--t-sub); font-weight: 500; cursor: pointer; white-space: nowrap; }
.chip[aria-pressed="true"] { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-text-on-primary); font-weight: 600; }
.hosts { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.host { padding: var(--space-1) var(--space-2); border-radius: var(--radius-xs); background: var(--color-surface-sunken); border: 1px solid var(--color-border); font-family: var(--font-mono); font-size: var(--t-cap); overflow-wrap: anywhere; }
.notice { display: flex; gap: var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: var(--color-primary-subtle); color: var(--color-text); font-size: var(--t-sub); line-height: var(--leading-normal); }
.notice .od-icon { margin-top: 2px; color: var(--color-primary); }
.notice.warn { background: var(--color-warning-subtle); } .notice.warn .od-icon { color: var(--color-warning); }
.notice.bad { background: var(--color-danger-subtle); } .notice.bad .od-icon { color: var(--color-danger); }
.notice.ok { background: var(--color-success-subtle); } .notice.ok .od-icon { color: var(--color-success); }
.notice.agent { background: var(--color-agent-subtle); } .notice.agent .od-icon { color: var(--color-agent); }
.notice b { font-weight: 600; }

/* ===== Sync chip row ===== */
.syncrow { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-3); }
.syncchip { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-3); border: 0; border-radius: var(--radius-sm); background: var(--color-surface-sunken); color: var(--color-text); font-size: var(--t-sub); font-weight: 600; cursor: pointer; }
.syncchip.ok { background: var(--color-success-subtle); color: var(--color-success); }
.syncchip.busy { background: var(--color-primary-subtle); color: var(--color-text-link); }
.syncchip.warn { background: var(--color-warning-subtle); color: var(--color-warning); }
.syncchip.off { background: var(--color-surface-sunken); color: var(--color-text-secondary); box-shadow: inset 0 0 0 1px var(--color-border-strong); }
.syncchip.busy .od-icon { animation: spin 1.2s linear infinite; }
.synccap { font-size: var(--t-foot); color: var(--color-text-secondary); }

/* ===== Search + list ===== */
.sb { display: flex; align-items: center; gap: var(--space-2); margin: var(--space-1) 0 var(--space-3); }
.sb-field { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-3); border-radius: var(--radius-sm); background: var(--color-surface-sunken); border: 1px solid var(--color-border); color: var(--color-text-secondary); }
.sb-in { flex: 1 1 0; min-width: 0; min-height: 42px; border: 0; background: none; color: var(--color-text); font-size: var(--t-body); outline-offset: 6px; }
.sb-in::placeholder { color: var(--color-text-tertiary); opacity: 1; }
.rail { display: flex; gap: var(--space-2); overflow-x: auto; margin: 0 calc(-1 * var(--space-4)) var(--space-3); padding: 0 var(--space-4); scrollbar-width: none; }
.rail::-webkit-scrollbar { display: none; }
.rail > * { flex: none; }
.rail::after { content: ""; flex: 0 0 var(--space-2); }
.searching .lt, .searching .syncrow, .searching .rail, .searching .banner { display: none; }
.swipe { position: relative; overflow: hidden; background: var(--color-surface); }
.swipe-actions { position: absolute; inset: 0 0 0 auto; display: flex; }
.swipe-actions button { width: 88px; border: 0; display: grid; place-items: center; align-content: center; gap: 2px; background: var(--color-primary); color: var(--color-text-on-primary); font-size: var(--t-cap); font-weight: 600; cursor: pointer; }
.swipe-actions button.d { background: var(--color-danger); }
.swipe-actions button.hidden-until { visibility: hidden; }
.swipe .row { position: relative; z-index: 1; background: var(--color-surface); transition: transform var(--duration-base) var(--ease-standard); touch-action: pan-y; }
.swipe.open .row { transform: translateX(-176px); }
.swipe:not(.open) .swipe-actions { visibility: hidden; }
.swipe.dragging .swipe-actions { visibility: visible; }
.swipe.dragging .row { transition: none; }
.why { margin-top: var(--space-1); }
.banner { display: flex; align-items: center; gap: var(--space-3); width: 100%; min-height: 56px; margin: 0 0 var(--space-3); padding: var(--space-3) var(--space-4); border: 0; border-radius: var(--radius-md); text-align: left; background: var(--color-agent-subtle); color: var(--color-text); cursor: pointer; }
.banner.warn { background: var(--color-warning-subtle); }
.banner .grow { flex: 1 1 0; min-width: 0; display: grid; gap: 2px; }
.banner .t { font-weight: 600; font-size: var(--t-sub); }
.banner .s { font-size: var(--t-foot); color: var(--color-text-secondary); }
.empty { display: grid; justify-items: center; gap: var(--space-3); text-align: center; padding: var(--space-8) var(--space-4); }
.empty h2 { margin: 0; font-size: var(--t-title); font-weight: 600; }
.empty p { margin: 0; color: var(--color-text-secondary); font-size: var(--t-body); line-height: var(--leading-normal); max-width: 300px; }
.empty .btn { width: auto; min-width: 200px; }
.meta { margin: 0 0 var(--space-2); padding: 0 var(--space-1); font-size: var(--t-foot); color: var(--color-text-secondary); }

/* ===== Secret field ===== */
.sf { display: grid; gap: var(--space-2); padding: var(--space-3) var(--space-4); }
.sf-val { min-height: 28px; font-size: var(--t-body); overflow-wrap: anywhere; word-break: break-all; }
.sf-val.masked { letter-spacing: 2px; color: var(--color-text); }
.sf-val.shown { font-family: var(--font-mono); font-variant-ligatures: none; background: var(--color-surface-sunken); border-radius: var(--radius-xs); padding: var(--space-2) var(--space-3); font-size: calc(var(--text-base) * var(--dt)); }
.sf-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.sf-status { display: grid; gap: var(--space-1); font-size: var(--t-foot); color: var(--color-text-secondary); }
.sf-status:empty { display: none; }
.bar { height: 4px; border-radius: var(--radius-full); background: var(--color-border); overflow: hidden; }
.bar i { display: block; height: 100%; width: 100%; background: var(--color-primary); transform-origin: left; transition: transform 1s linear; }
.bar.agent i { background: var(--color-agent); }
.kv { display: grid; gap: 2px; padding: var(--space-3) var(--space-4); }
.kv .k { font-size: var(--t-foot); color: var(--color-text-secondary); font-weight: 500; }
.kv .val { font-size: var(--t-body); overflow-wrap: anywhere; }
.kv .val.link { color: var(--color-text-link); }
.kvrow { display: flex; align-items: center; gap: var(--space-2); }
.kvrow .kv { flex: 1 1 0; min-width: 0; }
.kvrow .btn-sm { margin-right: var(--space-3); }
.keybox { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-surface-sunken); border: 1px solid var(--color-border); font-family: var(--font-mono); font-variant-ligatures: none; font-size: calc(var(--text-lg) * min(var(--dt), 1.4)); font-weight: 600; }
.keybox span { white-space: nowrap; }
.filebox { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); }

/* ===== Sheets / alerts / overlays ===== */
#ov { position: absolute; inset: 0; z-index: 12; pointer-events: none; }
#ov .ovl { position: absolute; inset: 0; pointer-events: auto; }
.scrim { position: absolute; inset: 0; background: var(--color-overlay); }
.ovl.in .scrim { animation: fadeIn var(--duration-base) var(--ease-enter); }
.ovl.out .scrim { animation: fadeOut calc(var(--duration-base) * .65) var(--ease-exit) forwards; }
.sheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: calc(100% - 54px); display: flex; flex-direction: column; background: var(--color-surface-raised); border-radius: var(--radius-xl) var(--radius-xl) 0 0; box-shadow: var(--shadow-lg); color: var(--color-text); font-size: var(--t-body); }
.sheet.full { top: 54px; max-height: none; }
.ovl.in .sheet { animation: sheetIn var(--duration-base) var(--ease-enter); }
.ovl.out .sheet { animation: sheetOut calc(var(--duration-base) * .65) var(--ease-exit) forwards; }
@keyframes fadeIn { from { opacity: 0; } }
@keyframes fadeOut { to { opacity: 0; } }
@keyframes sheetIn { from { transform: translateY(100%); } }
@keyframes sheetOut { to { transform: translateY(100%); } }
.grab { flex: none; display: grid; place-items: center; height: 24px; cursor: grab; touch-action: none; }
.grab::before { content: ""; width: 36px; height: 5px; border-radius: var(--radius-full); background: var(--color-border-strong); }
.sheet-head { flex: none; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: 0 var(--space-4) var(--space-2) var(--space-5); }
.sheet-head h2 { margin: 0; font-size: var(--t-title); font-weight: 600; line-height: var(--leading-snug); overflow-wrap: anywhere; }
.xbtn { flex: none; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: var(--radius-full); background: none; color: var(--color-text-secondary); cursor: pointer; }
.xbtn > .od-icon { padding: 6px; box-sizing: content-box; border-radius: var(--radius-full); background: var(--color-surface-sunken); }
.sheet-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 var(--space-4) var(--space-4); display: grid; gap: var(--space-4); align-content: start; scrollbar-width: none; }
.sheet-body::-webkit-scrollbar { display: none; }
.sheet-foot { flex: none; padding: var(--space-2) var(--space-4) calc(var(--phone-safe-bottom) + var(--space-1)); display: grid; gap: var(--space-2); }
.sheet .group { background: var(--color-surface); }
.sheet-body > .sheet-sp { height: var(--space-2); }

.alert { position: absolute; left: 50%; top: 50%; width: 290px; max-height: 80%; overflow-y: auto; transform: translate(-50%, -50%); background: var(--color-surface-raised); color: var(--color-text); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); text-align: center; }
.ovl.in .alert { animation: popIn var(--duration-base) var(--ease-enter); }
@keyframes popIn { from { opacity: 0; transform: translate(-50%, -50%) scale(.94); } }
.alert-body { padding: var(--space-5) var(--space-4) var(--space-4); display: grid; gap: var(--space-2); }
.alert h2 { margin: 0; font-size: var(--t-body); font-weight: 600; line-height: var(--leading-snug); overflow-wrap: anywhere; }
.alert p { margin: 0; font-size: var(--t-foot); color: var(--color-text-secondary); line-height: var(--leading-normal); overflow-wrap: anywhere; }
.alert .fld { text-align: left; margin-top: var(--space-2); }
.alert-btns { display: grid; border-top: 1px solid var(--color-border); }
.alert-btns button { min-height: 48px; border: 0; background: none; font-size: var(--t-body); color: var(--color-text-link); cursor: pointer; padding: var(--space-2) var(--space-3); }
.alert-btns button + button { border-top: 1px solid var(--color-border); }
.alert-btns button.bold { font-weight: 600; }
.alert-btns button.destructive { color: var(--color-danger); font-weight: 600; }
.menu { position: absolute; left: var(--space-5); right: var(--space-5); top: 50%; transform: translateY(-50%); background: var(--color-surface-raised); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); overflow: hidden; }
.menu h2 { margin: 0; padding: var(--space-3) var(--space-4); font-size: var(--t-foot); font-weight: 600; color: var(--color-text-secondary); border-bottom: 1px solid var(--color-border); overflow-wrap: anywhere; }
.menu button { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); width: 100%; min-height: 48px; padding: var(--space-2) var(--space-4); border: 0; background: none; text-align: left; font-size: var(--t-body); cursor: pointer; color: var(--color-text); }
.menu button + button { border-top: 1px solid var(--color-border); }
.menu button.d { color: var(--color-danger); }
.faceid { text-align: center; }
.faceid .alert-body { gap: var(--space-3); justify-items: center; }
.fid-glyph { width: 64px; height: 64px; display: grid; place-items: center; border-radius: var(--radius-lg); background: var(--color-primary-subtle); color: var(--color-primary); }
.fid-glyph.ok { background: var(--color-success-subtle); color: var(--color-success); }
.fid-glyph.bad { background: var(--color-warning-subtle); color: var(--color-warning); }
.fid-glyph .od-icon { }
.scanning .fid-glyph .od-icon { animation: pulse 1.2s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: .45; } }
#toast { position: absolute; left: var(--space-4); right: var(--space-4); bottom: calc(var(--phone-safe-bottom) + var(--tabbar-h) + var(--space-3)); z-index: 14; pointer-events: none; display: grid; justify-items: center; }
#toast .t { pointer-events: auto; display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); max-width: 100%; border-radius: var(--radius-md); background: var(--color-text); color: var(--color-bg); font-size: var(--t-sub); box-shadow: var(--shadow-md); animation: fadeIn var(--duration-base) var(--ease-enter); }
#toast .t button { min-height: 44px; padding: 0 var(--space-2); border: 0; background: none; color: var(--color-bg); font-weight: 700; text-decoration: underline; cursor: pointer; font-size: var(--t-sub); }

/* ===== Agent sheet ===== */
.ag-band { display: flex; align-items: center; gap: var(--space-3); margin: 0 var(--space-4) var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: var(--color-agent-subtle); color: var(--color-agent); font-weight: 600; font-size: var(--t-sub); }
.ag-band span { color: var(--color-text); font-weight: 400; display: block; font-size: var(--t-foot); }
.ag-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); overflow: hidden; }
.ag-list > li { display: flex; gap: var(--space-3); padding: var(--space-3) var(--space-4); }
.ag-list > li + li { border-top: 1px solid var(--color-border); }
.ag-list .q { flex: 1 1 0; min-width: 0; display: grid; gap: 2px; }
.ag-list .k { font-size: var(--t-cap); font-weight: 600; color: var(--color-agent); }
.ag-list .m { font-size: var(--t-body); font-weight: 600; overflow-wrap: anywhere; }
.ag-list .d { font-size: var(--t-foot); color: var(--color-text-secondary); line-height: var(--leading-normal); overflow-wrap: anywhere; }
.ag-list li.warnrow { background: var(--color-warning-subtle); }
.ag-list li.warnrow .k { color: var(--color-warning); }
.ag-state { display: grid; justify-items: center; gap: var(--space-3); text-align: center; padding: var(--space-4) var(--space-2); }
.ag-state h3 { margin: 0; font-size: var(--t-title); font-weight: 600; }
.ag-state p { margin: 0; color: var(--color-text-secondary); font-size: var(--t-body); line-height: var(--leading-normal); }

/* ===== Lock screen, Safari, switcher ===== */
.lockscr { position: absolute; inset: 0; padding: var(--phone-safe-top) var(--space-4) calc(var(--phone-safe-bottom) + var(--space-4)); display: grid; grid-template-rows: auto 1fr auto; background: color-mix(in srgb, var(--color-primary) 16%, var(--color-bg)); color: var(--color-text); }
.lk-time { display: grid; justify-items: center; gap: var(--space-1); padding-top: var(--space-6); }
.lk-time .tm { font-size: 76px; line-height: 1; font-weight: 600; letter-spacing: -0.02em; }
.lk-time .dt { font-size: var(--text-lg); font-weight: 500; color: var(--color-text-secondary); }
.notif { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; width: 100%; padding: var(--space-3) var(--space-4); margin-top: var(--space-6); text-align: left; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--color-surface-raised) 92%, transparent); box-shadow: var(--shadow-md); cursor: pointer; align-self: start; color: var(--color-text); }
.notif .nt { display: flex; justify-content: space-between; gap: var(--space-2); font-size: var(--text-xs); color: var(--color-text-secondary); font-weight: 500; }
.notif .nh { font-size: var(--text-base); font-weight: 600; margin-top: 2px; }
.notif .nb { font-size: var(--text-sm); color: var(--color-text-secondary); margin-top: 2px; line-height: var(--leading-snug); }
.notif .badge { margin-top: var(--space-2); }
.lk-foot { display: flex; justify-content: space-between; align-items: end; }
.lk-btn { width: 50px; height: 50px; border-radius: var(--radius-full); display: grid; place-items: center; background: var(--color-surface-raised); color: var(--color-text-secondary); border: 1px solid var(--color-border); }
.lk-hint { text-align: center; font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-3); }
.safari { position: absolute; inset: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; background: var(--color-surface-sunken); }
.sf-page { overflow: hidden; padding: calc(var(--phone-safe-top) + var(--space-3)) var(--space-4) var(--space-3); display: grid; align-content: start; gap: var(--space-4); }
.sf-card { padding: var(--space-5); border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-border); display: grid; gap: var(--space-4); }
.sf-card h1 { margin: 0; font-size: var(--t-title); }
.sf-card .fake { min-height: 44px; display: flex; align-items: center; padding: 0 var(--space-3); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-surface); font-size: var(--text-md); }
.sf-card .fake.focus { border-color: var(--color-primary); border-width: 2px; }
.sf-card .fake.empty { color: var(--color-text-tertiary); }
.sf-card .fl { font-size: var(--text-sm); color: var(--color-text-secondary); font-weight: 500; margin-bottom: var(--space-1); }
.urlbar { display: flex; align-items: center; gap: var(--space-2); margin: 0 var(--space-3) var(--space-2); min-height: 44px; padding: 0 var(--space-3); border-radius: var(--radius-md); background: var(--color-surface); border: 1px solid var(--color-border); font-size: var(--text-md); justify-content: center; color: var(--color-text); }
.sf-bottom { padding-bottom: var(--phone-safe-bottom); background: var(--color-surface-sunken); }
.kb { background: var(--color-surface-raised); border-top: 1px solid var(--color-border); padding-bottom: calc(var(--phone-safe-bottom) - 6px); }
.qt { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-2); min-height: 48px; border-bottom: 1px solid var(--color-border); }
.qt button { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-3); border: 0; border-radius: var(--radius-sm); background: none; color: var(--color-text); font-size: var(--text-base); cursor: pointer; }
.qt .sugg { flex: 1 1 0; min-width: 0; background: var(--color-primary-subtle); color: var(--color-text-link); font-weight: 600; }
.qt .sugg span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.keys { padding: var(--space-2) 3px 0; display: grid; gap: var(--space-2); }
.krow { display: flex; justify-content: center; gap: 5px; }
.krow i { flex: 1 1 0; height: 40px; max-width: 34px; border-radius: 6px; background: var(--color-surface); box-shadow: 0 1px 0 var(--color-border-strong); display: grid; place-items: center; font-style: normal; font-size: 20px; color: var(--color-text); }
.krow i.w { max-width: 90px; flex: 1.4 1 0; background: var(--color-surface-sunken); font-size: 15px; }
.krow i.sp { max-width: none; flex: 5 1 0; font-size: 15px; background: var(--color-surface); }
.switcher { position: absolute; inset: 0; padding-top: var(--phone-safe-top); background: color-mix(in srgb, var(--color-text) 14%, var(--color-surface-sunken)); display: grid; grid-template-rows: 1fr auto; }
.cards { display: flex; align-items: center; gap: var(--space-4); overflow-x: auto; padding: var(--space-4) calc(50% - 110px); scroll-snap-type: x mandatory; scrollbar-width: none; }
.cards::-webkit-scrollbar { display: none; }
.card { flex: none; width: 220px; scroll-snap-align: center; display: grid; gap: var(--space-2); justify-items: center; background: none; border: 0; padding: 0; color: var(--color-text); }
.card .cap { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: 600; }
.card .snap { width: 220px; height: 476px; border-radius: var(--radius-lg); overflow: hidden; background: var(--color-bg); border: 1px solid var(--color-border); display: grid; align-content: start; gap: var(--space-2); padding: var(--space-5) var(--space-3); }
.card .snap.priv { align-content: center; justify-items: center; gap: var(--space-3); text-align: center; }
.card .snap.priv p { margin: 0; font-size: var(--text-sm); color: var(--color-text-secondary); line-height: var(--leading-normal); }
.card .snap.priv strong { font-size: var(--text-md); }
.card .snap i { display: block; height: 10px; border-radius: var(--radius-xs); background: var(--color-surface-sunken); }
.card .snap i.s { width: 60%; } .card .snap i.h { height: 36px; border-radius: var(--radius-sm); }
.minilogo { width: 22px; height: 22px; border-radius: 6px; background: var(--color-surface-raised); border: 1px solid var(--color-border); display: grid; place-items: center; color: var(--color-text-secondary); }
.sw-note { padding: var(--space-3) var(--space-6) calc(var(--phone-safe-bottom) + var(--space-3)); text-align: center; font-size: var(--text-sm); color: var(--color-text-secondary); }

/* ===== Misc screens ===== */
.vf { position: relative; display: grid; place-items: center; align-content: center; gap: var(--space-3); width: 100%; aspect-ratio: 1; max-height: 300px; padding: var(--space-6); border: 0; border-radius: var(--radius-lg); background: var(--color-surface-sunken); color: var(--color-text-secondary); text-align: center; cursor: pointer; font-size: var(--t-sub); }
.vf::before, .vf::after { content: ""; position: absolute; width: 36px; height: 36px; border: 3px solid var(--color-primary); }
.vf::before { top: 20px; left: 20px; border-right: 0; border-bottom: 0; border-radius: 10px 0 0 0; }
.vf::after { bottom: 20px; right: 20px; border-left: 0; border-top: 0; border-radius: 0 0 10px 0; }
.spin { width: 56px; height: 56px; border-radius: var(--radius-full); border: 4px solid var(--color-border); border-top-color: var(--color-primary); animation: spin 1.1s linear infinite; }
.bigcode { font-family: var(--font-mono); font-size: calc(var(--text-3xl) * min(var(--dt), 1.5)); font-weight: 700; letter-spacing: 0.1em; }
.choice { display: flex; align-items: center; gap: var(--space-4); width: 100%; min-height: 76px; padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); text-align: left; color: var(--color-text); cursor: pointer; }
.choice .grow { flex: 1 1 0; min-width: 0; display: grid; gap: 2px; }
.choice .t { font-weight: 600; font-size: var(--t-body); }
.choice .s { font-size: var(--t-foot); color: var(--color-text-secondary); line-height: var(--leading-snug); }
.kit { padding: var(--space-4); border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); background: var(--color-surface); display: grid; gap: var(--space-3); }
.kit .kh { display: flex; align-items: center; gap: var(--space-3); font-weight: 700; font-size: var(--t-body); }
.kit .kr { display: grid; gap: 2px; padding-top: var(--space-3); border-top: 1px dashed var(--color-border-strong); }
.kit .kr b { font-size: var(--t-cap); font-weight: 600; color: var(--color-text-secondary); }
.pickbox { display: grid; place-items: center; gap: var(--space-3); padding: var(--space-5); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-lg); background: var(--color-surface-sunken); text-align: center; }
.pickbox p { margin: 0; font-size: var(--t-sub); color: var(--color-text-secondary); line-height: var(--leading-normal); }
.picker { background: var(--color-surface-raised); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border-strong); box-shadow: var(--shadow-md); }
.picker .ph { display: flex; justify-content: space-between; padding: var(--space-3) var(--space-4); font-weight: 600; border-bottom: 1px solid var(--color-border); font-size: var(--t-sub); }
.check { color: var(--color-primary); }
.gen { font-family: var(--font-mono); font-variant-ligatures: none; font-size: calc(var(--text-lg) * min(var(--dt), 1.4)); font-weight: 600; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-surface-sunken); overflow-wrap: anywhere; word-break: break-all; line-height: var(--leading-normal); }
.about-ver { display: grid; justify-items: center; gap: var(--space-2); text-align: center; padding: var(--space-6) 0; }
@media (prefers-reduced-motion: reduce) { .spin, .syncchip.busy .od-icon, .btn.loading .od-icon, .scanning .fid-glyph .od-icon { animation: none; } .bar i { transition: none; } }

  </style>
</head>
<body>
<aside class="stage-panel" aria-label="Prototype controls">
  <div>
    <h1>FigLock for iPhone</h1>
    <p>Reference prototype, made-up data only. These controls sit outside the phone and are not part of the app.</p>
  </div>
  <div>
    <label for="sw">Screen</label>
    <select id="sw"></select>
    <div class="pnav"><button type="button" class="pbtn" id="sw-prev">Previous</button><button type="button" class="pbtn" id="sw-next">Next</button></div>
    <p class="pcur" id="pcur" aria-live="polite"></p>
  </div>
  <div>
    <span class="pl" id="pl-theme">Appearance</span>
    <div class="pseg" role="group" aria-labelledby="pl-theme">
      <button type="button" data-p="theme" data-v="light" aria-pressed="true">Light</button>
      <button type="button" data-p="theme" data-v="dark" aria-pressed="false">Dark</button>
    </div>
  </div>
  <div>
    <span class="pl" id="pl-dt">Dynamic Type</span>
    <div class="pseg" role="group" aria-labelledby="pl-dt">
      <button type="button" data-p="dt" data-v="default" aria-pressed="true">Default</button>
      <button type="button" data-p="dt" data-v="large" aria-pressed="false">Large</button>
      <button type="button" data-p="dt" data-v="ax5" aria-pressed="false">AX5</button>
    </div>
    <p style="margin-top:8px">AX5 is shown at 2x body size, the DESIGN.md minimum a layout must survive.</p>
  </div>
  <div>
    <span class="pl" id="pl-face">Face ID result</span>
    <div class="pseg" role="group" aria-labelledby="pl-face">
      <button type="button" data-p="face" data-v="ok" aria-pressed="true">Recognizes me</button>
      <button type="button" data-p="face" data-v="fail" aria-pressed="false">Fails</button>
    </div>
  </div>
  <div>
    <span class="pl" id="pl-rm">Reduced motion</span>
    <div class="pseg" role="group" aria-labelledby="pl-rm">
      <button type="button" data-p="rm" data-v="off" aria-pressed="true">Off</button>
      <button type="button" data-p="rm" data-v="on" aria-pressed="false">On</button>
    </div>
  </div>
  <div class="phint" id="phint" aria-live="polite"></div>
  <button type="button" class="pbtn" id="p-reset">Reset sample data</button>
</aside>

  <div class="phone-frame" data-phone-shell data-platform="iphone">
    <span class="hardware-button silent" aria-hidden="true"></span>
    <span class="hardware-button volume-up" aria-hidden="true"></span>
    <span class="hardware-button volume-down" aria-hidden="true"></span>
    <span class="hardware-button power" aria-hidden="true"></span>

    <section class="phone-screen" data-phone-screen id="phone">
      <main class="phone-content" data-phone-content>
        <!-- APP CONTENT START -->
        <div id="app"></div>
        <!-- APP CONTENT END -->
      </main>
      <div id="ov"></div>
      <div id="toast"></div>
      <div id="live" class="sr-only" aria-live="polite" role="status"></div>

      <div class="status-bar" aria-hidden="true">
        <span>9:41</span>
        <span class="status-icons">
          <svg viewBox="0 0 18 12"><path d="M1 10.5h2V8H1v2.5Zm4 0h2V5.5H5v5Zm4 0h2V3H9v7.5Zm4 0h2V.5h-2v10Z"/></svg>
          <svg viewBox="0 0 18 12"><path d="M9 11.2 7.2 9.4a2.55 2.55 0 0 1 3.6 0L9 11.2Zm4.1-4.1-1.35 1.35a3.9 3.9 0 0 0-5.5 0L4.9 7.1a5.8 5.8 0 0 1 8.2 0Zm3-3-1.35 1.35a8.15 8.15 0 0 0-11.5 0L1.9 4.1a10.05 10.05 0 0 1 14.2 0Z"/></svg>
          <svg class="battery" viewBox="0 0 27 12"><path fill-rule="evenodd" d="M2.5 1h19A2.5 2.5 0 0 1 24 3.5v5a2.5 2.5 0 0 1-2.5 2.5h-19A2.5 2.5 0 0 1 0 8.5v-5A2.5 2.5 0 0 1 2.5 1Zm0 1A1.5 1.5 0 0 0 1 3.5v5A1.5 1.5 0 0 0 2.5 10h19A1.5 1.5 0 0 0 23 8.5v-5A1.5 1.5 0 0 0 21.5 2h-19Zm.5 1h17.5A1.5 1.5 0 0 1 22 4.5v3A1.5 1.5 0 0 1 20.5 9H3V3Zm22 1.5a1.5 1.5 0 0 1 0 3v-3Z"/></svg>
        </span>
      </div>
      <div class="dynamic-island" aria-hidden="true"></div>
      <div class="home-indicator" aria-hidden="true"></div>
    </section>
  </div>
<script>
'use strict';
/* ================= helpers ================= */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const clone = (o) => JSON.parse(JSON.stringify(o));
const rmOn = () => S.rm || matchMedia('(prefers-reduced-motion: reduce)').matches;
const dur = (ms) => (rmOn() ? 0 : ms);

/* SF Symbols style glyphs: 24 grid, 1.75 stroke, round joins */
const P = {
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  key: '<circle cx="8" cy="15.5" r="4"/><path d="M11 12.5 19.5 4M16.5 7l3 3M14 9.5l2 2"/>',
  fingerprint: '<path d="M4.5 11a7.5 7.5 0 0 1 15 0c0 1.4 0 2.8-.3 4"/><path d="M7.5 18.5c.6-1.6 1-3.4 1-5.5a3.5 3.5 0 0 1 7 0c0 2.2.2 3.8.8 5.3"/><path d="M12 13c0 2.8-.4 5-1.4 7"/><path d="M7 7.2A6 6 0 0 1 12 5"/>',
  bot: '<rect x="5" y="8.5" width="14" height="10.5" rx="3.5"/><path d="M12 8.5V5.5"/><circle cx="12" cy="4.2" r="1.2"/><path d="M9.5 13.2v.4M14.5 13.2v.4M2.8 13v2.4M21.2 13v2.4M9.5 16.3h5"/>',
  shield: '<path d="M12 3.5 19 6v5.5c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.4"/>',
  chevR: '<path d="M9.5 6l6 6-6 6"/>', chevL: '<path d="M14.5 6l-6 6 6 6"/>', chevD: '<path d="M6 9.5l6 6 6-6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>', x: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>', check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.4 3.6 5.2 3.6 8.5s-1.2 6.1-3.6 8.5c-2.4-2.4-3.6-5.2-3.6-8.5S9.6 5.9 12 3.5z"/>',
