const AUTOLOCKS = [['0', 'Immediately'], ['1', 'After 1 minute'], ['5', 'After 5 minutes'], ['15', 'After 15 minutes'], ['60', 'After 1 hour']];
const alLabel = (v) => (AUTOLOCKS.find((a) => a[0] === v) || AUTOLOCKS[2])[1];
const addMin = (m) => { const t = 9 * 60 + 41 + m; const h = Math.floor(t / 60) % 12 || 12; return `${h}:${String(t % 60).padStart(2, '0')} ${t >= 720 ? 'PM' : 'AM'}`; };
const lenLabel = (m) => (m === 60 ? '1 hour' : `${m} minutes`);

/* ================= state ================= */
function freshState() {
  return {
    stack: [{ id: 'onboarding' }], tabStacks: {}, ov: [], reveal: {}, copied: null,
    sync: 'synced', syncProvider: 'icloud', driveIn: true, driveAlert: false, folderOk: true,
    items: clone(ITEMS0), deleted: clone(DELETED0), filter: 'all', q: '', searching: false,
    settings: { autolock: '5', faceid: true },
    devices: clone(DEVICES0),
    req: { status: 'pending', mode: 'http', mins: 15, snoozed: false },
    grants: [{ id: 'g1', agent: 'Claude Code', item: 'Sentry auth token', until: 'until 10:20 AM', mode: 'Use through HTTP' }],
    history: [{ id: 'h1', agent: 'Claude Code', text: 'Used Vercel token through HTTP', when: 'Yesterday, 4:12 PM', ok: true }, { id: 'h2', agent: 'Claude Code', text: 'Asked to reveal Stripe API key', when: 'Yesterday, 11:03 AM', ok: false }],
    unlock: { fails: 0, pw: false, err: '' },
    create: { pw: '', pw2: '', keyShown: false, kitSaved: false, verify: '', err: '', busy: false, pwErr: '' },
    pair: { tab: 'scan', code: '', err: '', hold: false, declined: false },
    edit: null, af: { state: 'list', filled: false, q: '' },
    vaultName: "Mira's vault"
  };
}
const S = Object.assign(freshState(), { theme: 'light', dt: 'default', rm: false, faceOk: true, toast: null });
const SCREENS = {}, SHEETS = {}, ACT = {};
const top = () => S.stack[S.stack.length - 1];
const itemById = (id) => S.items.find((i) => i.id === id) || S.deleted.find((i) => i.id === id);
const TABROOT = { vault: 'list', agents: 'agents', settings: 'settings' };

/* ================= focus helpers ================= */
const activeFk = () => (document.activeElement && document.activeElement.dataset && document.activeElement.dataset.fk) || null;
const focusFk = (k) => { if (!k) return false; const el = $(`#phone [data-fk="${CSS.escape(k)}"]`); if (el) { el.focus({ preventScroll: true }); return true; } return false; };
const announce = (m) => { const l = $('#live'); if (!l) return; l.textContent = ''; setTimeout(() => { l.textContent = m; }, 30); };

/* ================= toast ================= */
let toastT = null;
function toast(msg, action) {
  clearTimeout(toastT);
  S.toast = { msg, action };
  $('#toast').innerHTML = `<div class="t" role="status"><span>${esc(msg)}</span>${action ? `<button type="button" data-act="toast-act">${esc(action.label)}</button>` : ''}</div>`;
  announce(msg);
  toastT = setTimeout(() => { S.toast = null; $('#toast').innerHTML = ''; }, 4500);
}
ACT['toast-act'] = () => { const a = S.toast && S.toast.action; $('#toast').innerHTML = ''; if (a) a.run(); };

/* ================= navigation ================= */
function curTab() { const d = SCREENS[top().id]; return d && d.tab; }
function saveScroll() { const sc = $('#main'); if (sc) top().scroll = sc.scrollTop; }
function push(id, props = {}) { saveScroll(); S.reveal = {}; S.stack.push({ id, ...props }); render(); }
function back() { if (S.stack.length > 1) { S.stack.pop(); S.reveal = {}; render(); } }
function reset(id, props = {}) { S.stack = [{ id, ...props }]; S.ov = []; S.reveal = {}; render(); }
function replaceTop(id, props = {}) { S.stack[S.stack.length - 1] = { id, ...props }; S.reveal = {}; render(); }
function selectTab(t) {
  const cur = curTab();
  if (cur === t) { const ri = S.stack.findIndex((x) => x.id === TABROOT[t]); S.stack = ri >= 0 ? S.stack.slice(0, ri + 1) : [{ id: TABROOT[t] }]; top().scroll = 0; render(); return; }
  if (cur) S.tabStacks[cur] = S.stack;
  S.stack = S.tabStacks[t] || [{ id: TABROOT[t] }];
  S.reveal = {}; render();
}

/* ================= common chrome ================= */
const navBack = (label) => `<button type="button" class="navbtn" data-act="back" data-fk="back" aria-label="Back to ${esc(label)}">${ic('chevL', 20)}<span>${esc(label)}</span></button>`;
const nav = ({ back: b, title = '', right = '', left = '', always = false, large = false } = {}) =>
  `<header class="nav${always ? ' always' : ''}" id="nav"><div class="nav-bar"><div class="nav-left">${left || (b ? navBack(b) : '')}</div><div class="nav-title" role="heading" aria-level="1"${large ? ' aria-hidden="true"' : ''}>${esc(title)}</div><div class="nav-right">${right}</div></div></header>`;
const tabbar = (active) => {
  const waiting = S.req.status === 'pending' ? 1 : 0;
  return `<nav class="tabbar" aria-label="Main">${[['vault', 'Vault', 'lock'], ['agents', 'Agents', 'bot'], ['settings', 'Settings', 'gear']]
    .map(([id, l, i]) => `<button type="button" class="tab${active === id ? ' on' : ''}" data-act="tab" data-arg="${id}" data-fk="tab-${id}"${active === id ? ' aria-current="page"' : ''}>${ic(i, 26)}<span>${l}</span>${id === 'agents' && waiting ? '<span class="badge-n" aria-label="1 request waiting">1</span>' : ''}</button>`).join('')}</nav>`;
};
function frame(navHtml, inner, { tab, foot, collapse = 44, cls = '' } = {}) {
  return `<div class="screen ${tab ? 'hastab' : ''} ${foot ? 'hasfoot' : ''} ${S.dt === 'ax5' ? 'ax5' : ''} ${cls}">${navHtml}<main class="scroll" id="main" data-collapse="${collapse}" tabindex="-1">${inner}</main>${tab ? tabbar(tab) : foot ? `<footer class="foot">${foot}</footer>` : '<div></div>'}</div>`;
}
const seg = (label, opts, val, act) => `<div class="seg" role="radiogroup" aria-label="${esc(label)}">${opts.map(([v, l]) => `<button type="button" role="radio" aria-checked="${v === val}" class="${v === val ? 'on' : ''}" data-act="${act}" data-arg="${v}" data-fk="${act}-${v}">${esc(l)}</button>`).join('')}</div>`;
const sw = (on, act, label, arg = '') => `<button type="button" class="switch" role="switch" aria-checked="${on}" aria-label="${esc(label)}" data-act="${act}" data-arg="${arg}" data-fk="${act}${arg}"></button>`;
const errmsg = (id, msg) => `<p class="errmsg" id="${id}" role="alert">${ic('warn', 16)}<span>${esc(msg)}</span></p>`;

/* ================= render ================= */
let lastTop = null;
function render() {
  const t = top(), def = SCREENS[t.id];
  const fk = activeFk();
  const prevScroll = $('#main') ? $('#main').scrollTop : 0;
  document.documentElement.dataset.theme = S.theme;
  document.documentElement.dataset.dt = S.dt;
  document.documentElement.classList.toggle('rm', S.rm);
  $('#app').innerHTML = def.render(t);
  const sc = $('#main');
  if (sc) {
    if (t === lastTop) sc.scrollTop = prevScroll;
    else if (t.scroll != null) sc.scrollTop = t.scroll;
    else if (def.initScroll) sc.scrollTop = def.initScroll();
  }
  lastTop = t;
  const nv = $('#nav'); if (sc && nv) nv.classList.toggle('collapsed', sc.scrollTop > Number(sc.dataset.collapse || 44));
  if (def.after) def.after(t);
  renderOv();
  if (fk && !S.ov.length) focusFk(fk);
  syncPanel();
}

/* ================= overlays ================= */
let closing = false;
function openOv(o) { o.fresh = true; o.opener = activeFk(); S.ov.push(o); renderOv(true); }
function dismissOv(o) { const i = S.ov.indexOf(o); if (i >= 0) { S.ov.splice(i, 1); renderOv(); if (o.opener && !S.ov.length) focusFk(o.opener); } }
function closeOv(after) {
  if (closing || !S.ov.length) return;
  closing = true;
  const els = $$('#ov > .ovl'); const el = els[els.length - 1]; if (el) el.classList.add('out');
  setTimeout(() => { const o = S.ov.pop(); closing = false; renderOv(); if (o && o.opener && !S.ov.length) focusFk(o.opener); if (o && o.onClose) o.onClose(); if (after) after(); }, dur(140));
}
const grab = '<div class="grab" data-grab aria-hidden="true"></div>';
function sheetHtml(o) {
  const s = SHEETS[o.id](o);
  const head = s.custom ? '' : `<div class="sheet-head"><h2 id="ov-title"${s.tint ? ` style="color:var(--color-${s.tint})"` : ''}>${esc(s.title)}</h2><button type="button" class="xbtn" data-act="ov-close" data-fk="ov-close" aria-label="Close">${ic('x', 20)}</button></div>`;
  return `<div class="scrim" data-act="ov-dismiss"></div><section class="sheet${s.full ? ' full' : ''}" role="dialog" aria-modal="true" aria-labelledby="ov-title" data-grabsheet>${grab}${head}<div class="sheet-body">${s.body}</div>${s.foot ? `<div class="sheet-foot">${s.foot}</div>` : '<div class="sheet-foot"></div>'}</section>`;
}
function alertHtml(o) {
  const btns = o.buttons.map((b, i) => `<button type="button" class="${b.style || ''}" data-act="alert-btn" data-arg="${i}" data-fk="alert-${i}">${esc(b.label)}</button>`).join('');
  return `<div class="scrim"></div><div class="alert" role="alertdialog" aria-modal="true" aria-labelledby="ov-title" aria-describedby="ov-desc"><div class="alert-body"><h2 id="ov-title">${esc(o.title)}</h2><p id="ov-desc">${esc(o.msg)}</p>${o.extra || ''}</div><div class="alert-btns">${btns}</div></div>`;
}
function faceHtml(o) {
  const st = o.state;
  const glyph = st === 'ok' ? ic('check', 36) : st === 'fail' ? ic('warn', 36) : ic('fingerprint', 36);
  const title = st === 'ok' ? 'Face ID recognized' : st === 'fail' ? 'Face ID did not recognize you' : 'Face ID';
  const msg = st === 'fail' ? 'Try again or use your password.' : st === 'ok' ? 'Done.' : o.reason;
  const btns = st === 'fail'
    ? `<button type="button" class="bold" data-act="fid-retry" data-fk="fid-retry">Try Face ID again</button><button type="button" data-act="fid-pw" data-fk="fid-pw">Use password</button><button type="button" data-act="fid-cancel" data-fk="fid-cancel">Cancel</button>`
    : st === 'ok' ? '' : `<button type="button" data-act="fid-cancel" data-fk="fid-cancel">Cancel</button>`;
  return `<div class="scrim"></div><div class="alert faceid ${st === 'scan' ? 'scanning' : ''}" role="alertdialog" aria-modal="true" aria-labelledby="ov-title" aria-describedby="ov-desc"><div class="alert-body"><div class="fid-glyph ${st === 'ok' ? 'ok' : st === 'fail' ? 'bad' : ''}">${glyph}</div><h2 id="ov-title">${title}</h2><p id="ov-desc">${esc(msg)}</p></div>${btns ? `<div class="alert-btns">${btns}</div>` : ''}</div>`;
}
function menuHtml(o) {
  return `<div class="scrim" data-act="ov-dismiss"></div><div class="menu" role="menu" aria-label="${esc(o.title)}"><h2>${esc(o.title)}</h2>${o.items.map((m, i) => `<button type="button" role="menuitem" class="${m.danger ? 'd' : ''}" data-act="menu-item" data-arg="${i}" data-fk="menu-${i}"><span>${esc(m.label)}</span>${ic(m.icon, 20)}</button>`).join('')}</div>`;
}
function renderOv(focusNew) {
  const host = $('#ov'); if (!host) return;
  const fk = activeFk();
  host.innerHTML = S.ov.map((o, i) => {
    const inner = o.type === 'sheet' ? sheetHtml(o) : o.type === 'alert' ? alertHtml(o) : o.type === 'faceid' ? faceHtml(o) : menuHtml(o);
    const cls = o.fresh ? ' in' : '';
    return `<div class="ovl${cls}" data-i="${i}">${inner}</div>`;
  }).join('');
  const fresh = S.ov.filter((o) => o.fresh);
  S.ov.forEach((o) => { o.fresh = false; });
  const lastEl = host.lastElementChild;
  if (lastEl) {
    const target = $('[data-autofocus]', lastEl) || $('input:not([type=hidden]), textarea', lastEl) || $('button, [href]', lastEl);
    if (fresh.length || focusNew) { if (target) target.focus({ preventScroll: true }); }
    else if (fk) { if (!focusFk(fk) && target) target.focus({ preventScroll: true }); }
  }
}
function alertDlg(title, msg, buttons, extra) { openOv({ type: 'alert', title, msg, buttons, extra }); }
const cancelBtn = { label: 'Cancel', style: 'bold' };
ACT['alert-btn'] = (el, arg) => { const o = S.ov[S.ov.length - 1]; const b = o.buttons[Number(arg)]; if (b.keep) { if (b.run) b.run(o); return; } closeOv(() => { if (b.run) b.run(); }); };
ACT['ov-close'] = () => closeOv();
ACT['ov-dismiss'] = () => closeOv();
ACT['menu-item'] = (el, arg) => { const o = S.ov[S.ov.length - 1]; const m = o.items[Number(arg)]; closeOv(() => m.run()); };
function openSheet(id, data = {}) { openOv({ type: 'sheet', id, ...data }); }

/* Face ID prompt */
function faceId(reason, ok, cancel) {
  const o = { type: 'faceid', reason, state: 'scan' };
  const finish = () => {
    if (!S.ov.includes(o)) return;
    if (S.faceOk) {
      o.state = 'ok'; renderOv();
      setTimeout(() => { if (!S.ov.includes(o)) return; dismissOv(o); ok(); }, dur(450));
    } else { o.state = 'fail'; renderOv(); }
  };
  o.start = () => { o.state = 'scan'; renderOv(); setTimeout(finish, dur(900)); };
  o.ok = ok; o.cancel = cancel;
  openOv(o); setTimeout(finish, dur(900));
}
ACT['fid-cancel'] = () => { const o = S.ov[S.ov.length - 1]; dismissOv(o); if (o.cancel) o.cancel(); };
ACT['fid-retry'] = () => { const o = S.ov[S.ov.length - 1]; o.start(); };
ACT['fid-pw'] = () => {
  const o = S.ov[S.ov.length - 1]; dismissOv(o);
  openOv({ type: 'alert', title: 'Enter password', msg: 'Face ID did not work, so FigLock needs your password for this.', extra: `<div class="fld"><label class="label" for="mp">Password</label><input class="input" id="mp" type="password" autocomplete="off" data-autofocus aria-describedby="mp-err"><p id="mp-err" class="errmsg" role="alert" hidden>${ic('warn', 16)}<span>That password isn't right. Check it and try again.</span></p></div>`,
    buttons: [{ label: 'Cancel', run: () => { if (o.cancel) o.cancel(); } }, { label: 'Continue', style: 'bold', keep: true, run: (a) => { const v = $('#mp').value; if (v === SAMPLE_PW) { dismissOv(a); o.ok(); } else { $('#mp-err').hidden = false; $('#mp').classList.add('err'); } } }] });
};

/* ================= secret fields ================= */
const secretOf = (key) => {
  if (key === 'seckey') return KEY.join('-');
  const [id] = key.split(':'); const it = itemById(id); return it ? it.secret : '';
};
const isRev = (k) => S.reveal[k] && S.reveal[k] > Date.now();
const isCopied = (k) => S.copied && S.copied.key === k && S.copied.until > Date.now();
function statusHtml(k) {
  let h = '';
  if (isRev(k)) { const n = Math.ceil((S.reveal[k] - Date.now()) / 1000); h += `<div data-cdr="${k}">Hides again in ${n} s</div><div class="bar" aria-hidden="true"><i data-bar-r="${k}" style="transform:scaleX(${Math.max(0, (S.reveal[k] - Date.now()) / 10000)})"></i></div>`; }
  if (isCopied(k)) { const n = Math.ceil((S.copied.until - Date.now()) / 1000); h += `<div data-cdc="${k}">Copied. Clipboard clears in ${n} s</div><div class="bar" aria-hidden="true"><i data-bar-c="${k}" style="transform:scaleX(${Math.max(0, (S.copied.until - Date.now()) / 30000)})"></i></div>`; }
  return h;
}
function secretField(key, label) {
  const rev = isRev(key);
  return `<div class="sf" id="sf-${key.replace(':', '-')}"><div class="label" id="sfl-${key.replace(':', '-')}">${esc(label)}</div>
    <div class="sf-val ${rev ? 'shown' : 'masked'}" aria-labelledby="sfl-${key.replace(':', '-')}">${rev ? esc(secretOf(key)) : '<span class="sr-only">Hidden</span><span aria-hidden="true">••••••••••••</span>'}</div>
    <div class="sf-actions"><button type="button" class="btn-sm" data-act="reveal" data-arg="${key}" data-fk="rv-${key}" aria-label="${rev ? 'Hide' : 'Show'} ${esc(label)}">${ic(rev ? 'eyeOff' : 'eye', 18)}<span>${rev ? 'Hide' : 'Show'}</span></button><button type="button" class="btn-sm" data-act="copy" data-arg="${key}" data-fk="cp-${key}" aria-label="Copy ${esc(label)}, clears from the clipboard in 30 seconds">${ic('copy', 18)}<span>Copy</span></button></div>
    <div class="sf-status" data-cd="${key}">${statusHtml(key)}</div></div>`;
}
ACT.reveal = (el, key) => {
  if (isRev(key)) { delete S.reveal[key]; render(); announce('Hidden'); return; }
  const label = key === 'seckey' ? 'Secret Key' : 'secret';
  faceId(`Show the ${label} in FigLock`, () => { S.reveal[key] = Date.now() + 10000; render(); announce('Shown. It hides again in 10 seconds.'); });
};
ACT.copy = (el, key) => { S.copied = { key, until: Date.now() + 30000 }; render(); toast('Copied. The clipboard clears in 30 s'); };
ACT['copy-plain'] = (el, what) => toast(`${what} copied`);
setInterval(() => {
  const now = Date.now(); let need = false;
  Object.keys(S.reveal).forEach((k) => { if (S.reveal[k] <= now) { delete S.reveal[k]; need = true; announce('Hidden again'); } });
  if (S.copied && S.copied.until <= now) { S.copied = null; need = true; }
  if (need) { render(); return; }
  $$('[data-cdr]').forEach((n) => { n.textContent = `Hides again in ${Math.max(1, Math.ceil((S.reveal[n.dataset.cdr] - now) / 1000))} s`; });
  $$('[data-bar-r]').forEach((n) => { n.style.transform = `scaleX(${Math.max(0, (S.reveal[n.dataset.barR] - now) / 10000)})`; });
  $$('[data-cdc]').forEach((n) => { if (S.copied) n.textContent = `Copied. Clipboard clears in ${Math.max(1, Math.ceil((S.copied.until - now) / 1000))} s`; });
  $$('[data-bar-c]').forEach((n) => { if (S.copied) n.style.transform = `scaleX(${Math.max(0, (S.copied.until - now) / 30000)})`; });
}, 1000);

/* ================= 1 Onboarding ================= */
const choice = (icon, t, s, act, arg = '') => `<button type="button" class="choice" data-act="${act}" data-arg="${arg}" data-fk="${act}${arg}"><span class="tile big">${ic(icon, 26)}</span><span class="grow"><span class="t">${t}</span><span class="s">${s}</span></span>${ic('chevR', 18, 'chev')}</button>`;
SCREENS.onboarding = {
  render: () => frame(nav({}), `<div class="hero">${logo(72)}<h1 class="lt" style="margin-top:12px">Welcome to FigLock</h1><p class="sub">Passwords, API tokens and files in a vault that only you can open.</p></div>
    <div class="stack" style="margin-top:8px">
      ${choice('phone', 'Join my vault by pairing', 'Pair this iPhone with a device that already has your vault.', 'ob-pair')}
      ${choice('plus', 'Create a new vault', 'Start fresh with a password and a Secret Key.', 'ob-create')}
      ${choice('cloud', 'Open my vault from Google Drive', 'Sign in to Google Drive and pick the vault you saved there.', 'ob-drive')}
    </div><p class="gfoot" style="margin-top:16px;padding:0">You can change where your vault syncs later in Settings.</p>`)
};
ACT['ob-pair'] = () => { S.pair = { tab: 'scan', code: '', err: '', hold: false, declined: false }; push('pair-scan'); };
ACT['ob-create'] = () => { S.create = freshState().create; push('create-pw'); };
ACT['ob-drive'] = () => push('drive-signin', { onboarding: true });
SCREENS['drive-open'] = {
  render: () => frame(nav({ back: 'Welcome' }), `<h1 class="lt">Open your vault</h1><p class="sub">Signed in to Google Drive as ${ME}. FigLock found one vault.</p>
    <div class="group"><div class="cell" style="cursor:default"><span class="tile">${ic('lock', 22)}</span><span class="grow"><span class="t b">Mira's vault</span><span class="s">Last changed yesterday at 6:48 PM</span></span></div></div>
    <div class="stack4" style="margin-top:24px">
      <div class="fld"><label class="label" for="dk">Secret Key</label><input class="input mono" id="dk" autocomplete="off" autocapitalize="characters" spellcheck="false" value="FL1-ABCD-EFGH-JKLM-NPQR-STUV" aria-describedby="dk-h"><p class="hint" id="dk-h">From your Emergency Kit. Needed once on each new device.</p></div>
      <div class="fld"><label class="label" for="dm">Password</label><input class="input" id="dm" type="password" autocomplete="off" value="${SAMPLE_PW}"></div>
    </div>`, { foot: `<button type="button" class="btn" data-act="drive-open-go" data-fk="drive-open-go">Open vault</button>` })
};
ACT['drive-open-go'] = () => { S.sync = 'syncing'; reset('list'); startSync(); };

/* ================= 2 Pairing ================= */
const normCode = (v) => { const c = v.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6); return c.length > 3 ? c.slice(0, 3) + '-' + c.slice(3) : c; };
SCREENS['pair-scan'] = {
  render: () => {
    const tab = S.pair.tab;
    const body = tab === 'scan'
      ? `<button type="button" class="vf" data-act="pair-scan" data-fk="vf" aria-label="Camera viewfinder. Tap to scan the sample pairing code.">${ic('qr', 44)}<span>Point the camera at the code on your other device.</span></button>
         <ol class="hint" style="padding-left:20px;line-height:1.6"><li>On your other device open FigLock, then Settings and Devices.</li><li>Choose Add device.</li><li>Scan the code, or switch to Enter code.</li></ol>`
      : `<div class="fld"><label class="label" for="pc">Pairing code</label><input class="input mono" id="pc" data-bind="pair.code" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="7" value="${esc(S.pair.code)}" aria-describedby="pc-h pc-e"><p class="hint" id="pc-h">Six letters and numbers, like K7M-2QX. It is shown on your other device.</p><div id="pc-e">${S.pair.err ? errmsg('pc-err', S.pair.err) : ''}</div></div>`;
    return frame(nav({ back: 'Welcome', title: 'Pair this iPhone', always: true }), `<p class="step">Join an existing vault</p><h1 class="lt2" style="margin-bottom:16px">Pair this iPhone</h1>${seg('Pairing method', [['scan', 'Scan code'], ['enter', 'Enter code']], tab, 'pair-tab')}<div class="stack4" style="margin-top:20px">${body}</div>`,
      tab === 'enter' ? { foot: `<button type="button" class="btn" id="pc-go" data-act="pair-go" data-fk="pc-go"${S.pair.code.length === 7 ? '' : ' disabled'}>Continue</button>` } : {});
  },
  onInput: (el) => { S.pair.code = normCode(el.value); el.value = S.pair.code; S.pair.err = ''; $('#pc-e').innerHTML = ''; el.classList.remove('err'); $('#pc-go').disabled = S.pair.code.length !== 7; },
  onBlur: (el) => { if (el.id === 'pc' && S.pair.code && S.pair.code.length !== 7) { S.pair.err = "That code is too short. It has six letters and numbers, like K7M-2QX."; $('#pc-e').innerHTML = errmsg('pc-err', S.pair.err); el.classList.add('err'); } }
};
ACT['pair-tab'] = (el, v) => { S.pair.tab = v; render(); };
ACT['pair-scan'] = () => { S.pair.code = 'K7M-2QX'; replaceTop('pair-wait'); };
ACT['pair-go'] = () => { if (S.pair.code.length === 7) replaceTop('pair-wait'); };
let pairTimer = null;
SCREENS['pair-wait'] = {
  render: () => S.pair.declined
    ? frame(nav({ back: 'Welcome', title: 'Pairing' }), `<div class="hero center" style="padding-top:48px"><span class="tile xl bad">${ic('x', 36)}</span><h1 class="lt2">Studio Mac declined</h1><p class="sub">Someone on Studio Mac chose Deny, so this iPhone was not added. Pair again, or ask the owner of the vault to approve it.</p></div>`, { foot: `<button type="button" class="btn" data-act="pair-again" data-fk="pair-again">Pair again</button><button type="button" class="btn plain" data-act="back" data-fk="back2">Back to welcome</button>` })
    : frame(nav({ back: 'Welcome', title: 'Pairing' }), `<div class="hero center" style="padding-top:40px"><div class="spin" role="img" aria-label="Waiting"></div><h1 class="lt2" style="margin-top:12px">Waiting for approval</h1><p class="sub">On Studio Mac, open FigLock and approve “Mira's iPhone”. Check that it shows the number below.</p>
      <div class="group" style="width:100%"><div class="kv" style="text-align:center"><span class="k">Number to check</span><span class="bigcode" aria-label="4 8 2 1">4821</span></div></div>
      <p class="hint" style="margin-top:8px">There is no time limit. You can leave this screen and pair later.</p></div>`, { foot: `<button type="button" class="btn secondary" data-act="back" data-fk="pw-cancel">Cancel pairing</button>` }),
  after: () => { clearTimeout(pairTimer); if (!S.pair.hold && !S.pair.declined) pairTimer = setTimeout(() => { if (top().id === 'pair-wait') replaceTop('pair-done'); }, 4000); }
};
ACT['pair-again'] = () => { S.pair = { tab: 'scan', code: '', err: '', hold: false, declined: false }; replaceTop('pair-scan'); };
SCREENS['pair-done'] = {
  render: () => frame(nav({ title: 'Paired', left: '' }), `<div class="hero center" style="padding-top:32px"><span class="tile xl ok">${ic('shield', 38)}</span><h1 class="lt2">This iPhone is paired</h1><p class="sub">Studio Mac approved “Mira's iPhone”. Your vault is syncing now.</p></div>
    <div class="group"><div class="fld" style="padding:12px 16px"><label class="label" for="dn">Device name</label><input class="input" id="dn" value="Mira's iPhone" aria-describedby="dn-h"><p class="hint" id="dn-h">Shown in the device list on your other devices.</p></div>
    <div class="cell" style="cursor:default"><span class="grow"><span class="t">Unlock with Face ID</span><span class="s">Use your face instead of typing the password.</span></span>${sw(S.settings.faceid, 'set-face', 'Unlock with Face ID')}</div></div>`, { foot: `<button type="button" class="btn" data-act="pair-finish" data-fk="pair-finish">Open my vault</button>` })
};
ACT['pair-finish'] = () => { S.sync = 'syncing'; reset('list'); startSync(); };
ACT['set-face'] = () => {
  if (S.settings.faceid) alertDlg('Turn off Face ID?', 'You will use your password to unlock FigLock on this iPhone.', [cancelBtn, { label: 'Turn off', style: 'destructive', run: () => { S.settings.faceid = false; render(); } }]);
  else faceId('Turn on Face ID for FigLock', () => { S.settings.faceid = true; render(); });
};

/* ================= 3 Create vault ================= */
function strength(p) {
  if (!p) return null; let s = 0;
  if (p.length >= 12) s++; if (p.length >= 16) s++; if (/[a-z]/.test(p) && /[A-Z]/.test(p)) s++; if (/\d/.test(p)) s++; if (/[^A-Za-z0-9]/.test(p)) s++;
  return s <= 1 ? ['Weak', 'weak', 'bad'] : s <= 3 ? ['Okay', 'ok', 'warn'] : ['Strong', 'strong', 'ok'];
}
const strengthHtml = (p) => { const s = strength(p); return s ? `<div class="meter ${s[1]}" aria-hidden="true"><span></span><span></span><span></span></div><div class="mtxt i-${s[2]}">${ic(s[1] === 'strong' ? 'okc' : 'warn', 16)}<span>${s[0]}${s[1] === 'weak' ? ': use at least 12 characters' : ''}</span></div>` : ''; };
SCREENS['create-pw'] = {
  render: () => frame(nav({ back: 'Welcome', title: 'Create vault', always: true }), `<p class="step">Step 1 of 4</p><h1 class="lt2">Choose a password</h1><p class="sub" style="margin-top:8px">It unlocks your vault. FigLock can't reset it, so pick something long that you can remember.</p>
    <div class="stack4"><div class="fld"><label class="label" for="cp1">Password <span class="req">(required)</span></label><div class="pwrow"><input class="input" id="cp1" type="password" data-bind="create.pw" autocomplete="new-password" value="${esc(S.create.pw)}" aria-describedby="cp1-s"><button type="button" class="iconbtn" data-act="cp-eye" data-fk="cp-eye" aria-label="Show password" aria-pressed="false">${ic('eye', 22)}</button></div><div id="cp1-s" class="stack" style="gap:6px">${strengthHtml(S.create.pw)}</div></div>
    <div class="fld"><label class="label" for="cp2">Confirm password <span class="req">(required)</span></label><input class="input" id="cp2" type="password" data-bind="create.pw2" autocomplete="new-password" value="${esc(S.create.pw2)}" aria-describedby="cp2-e"><div id="cp2-e">${S.create.pwErr ? errmsg('cp2-err', S.create.pwErr) : ''}</div></div></div>`,
    { foot: `<button type="button" class="btn" id="cp-go" data-act="cp-go" data-fk="cp-go"${S.create.pw.length >= 12 ? '' : ' disabled'}>Continue</button>` }),
  onInput: (el) => { if (el.id === 'cp1') { $('#cp1-s').innerHTML = strengthHtml(S.create.pw); $('#cp-go').disabled = S.create.pw.length < 12; } S.create.pwErr = ''; $('#cp2-e').innerHTML = ''; $('#cp2').classList.remove('err'); },
  onBlur: (el) => { if (el.id === 'cp2' && S.create.pw2 && S.create.pw2 !== S.create.pw) { S.create.pwErr = "The two passwords don't match. Type the same password in both fields."; $('#cp2-e').innerHTML = errmsg('cp2-err', S.create.pwErr); el.classList.add('err'); } }
};
ACT['cp-eye'] = (el) => { const on = el.getAttribute('aria-pressed') !== 'true'; el.setAttribute('aria-pressed', on); el.setAttribute('aria-label', on ? 'Hide password' : 'Show password'); $('#cp1').type = on ? 'text' : 'password'; $('#cp2').type = on ? 'text' : 'password'; el.innerHTML = ic(on ? 'eyeOff' : 'eye', 22); };
ACT['cp-go'] = () => {
  if (S.create.pw2 !== S.create.pw) { S.create.pwErr = "The two passwords don't match. Type the same password in both fields."; render(); $('#cp2').classList.add('err'); $('#cp2').focus(); return; }
  S.create.keyShown = false; push('create-key');
};
SCREENS['create-key'] = {
  render: () => {
    const shown = S.create.keyShown;
    return frame(nav({ back: 'Password', title: 'Secret Key', always: true }), `<p class="step">Step 2 of 4</p><h1 class="lt2">Your Secret Key</h1><p class="sub" style="margin-top:8px">With your password, it protects your vault. You need both to add a new device.</p>
      <div class="notice warn" style="margin-bottom:16px">${ic('warn', 20)}<div><b>Keep this safe, it is shown only once.</b><br>FigLock can't recover it for you.</div></div>
      <div class="keybox" aria-label="Secret Key">${shown ? KEY.map((g) => `<span>${g}</span>`).join('') : '<span class="sr-only">Hidden</span>' + KEY.map((g) => `<span aria-hidden="true">${'•'.repeat(g.length)}</span>`).join('')}</div>
      <div class="sf-actions" style="margin-top:12px"><button type="button" class="btn-sm" data-act="ck-show" data-fk="ck-show" aria-pressed="${shown}">${ic(shown ? 'eyeOff' : 'eye', 18)}<span>${shown ? 'Hide' : 'Show'} Secret Key</span></button></div>
      <p class="hint" style="margin-top:8px">${shown ? 'Stays visible until you continue.' : 'Hidden until you choose Show.'}</p>`, { foot: `<button type="button" class="btn" data-act="ck-go" data-fk="ck-go">Continue to Emergency Kit</button>` });
  }
};
ACT['ck-show'] = () => { S.create.keyShown = !S.create.keyShown; render(); };
ACT['ck-go'] = () => { S.create.keyShown = false; push('create-kit'); };
SCREENS['create-kit'] = {
  render: () => frame(nav({ back: 'Secret Key', title: 'Emergency Kit', always: true }), `<p class="step">Step 3 of 4</p><h1 class="lt2">Save your Emergency Kit</h1><p class="sub" style="margin-top:8px">A one page PDF with your Secret Key. Store it printed or offline, away from this iPhone.</p>
    <div class="kit"><div class="kh">${logo(32)}<span>FigLock Emergency Kit</span></div><div class="kr"><b>Vault</b><span>Mira's vault</span></div><div class="kr"><b>Email</b><span>${ME}</span></div><div class="kr"><b>Secret Key</b><span class="mono" aria-label="Secret Key, included in the file">${'•'.repeat(28)}</span></div><div class="kr"><b>Password</b><span class="hint">Write it in by hand. FigLock never prints it.</span></div></div>
    ${S.create.kitSaved ? `<div class="notice ok" style="margin-top:16px">${ic('okc', 20)}<div><b>Saved as FigLock Emergency Kit.pdf</b><br>You can save it again from Settings.</div></div>` : ''}`,
    { foot: S.create.kitSaved ? `<button type="button" class="btn" data-act="kit-go" data-fk="kit-go">I saved it, continue</button><button type="button" class="btn secondary" data-act="kit-save" data-fk="kit-save">Save again</button>` : `<button type="button" class="btn" data-act="kit-save" data-fk="kit-save">${ic('share', 20)}Save Emergency Kit</button>` })
};
SHEETS['share-kit'] = (o) => ({ title: 'Save Emergency Kit', body: `<p class="hint">FigLock Emergency Kit.pdf - 1 page - contains your Secret Key</p><div class="group">${[['folder', 'Save to Files', 'Choose a folder on this iPhone or in iCloud Drive.'], ['printer', 'Print', 'Send it to a printer and keep the paper copy.'], ['airdrop', 'AirDrop', 'Send it to your own Mac. Do not send it to anyone else.']].map(([i, t, s]) => `<button type="button" class="cell" data-act="kit-do" data-arg="${t}" data-fk="kit-${i}"><span class="tile">${ic(i, 22)}</span><span class="grow"><span class="t b">${t}</span><span class="s">${s}</span></span></button>`).join('')}</div>` });
ACT['kit-save'] = () => openSheet('share-kit');
ACT['kit-do'] = (el, what) => closeOv(() => { S.create.kitSaved = true; if (top().id === 'create-kit') render(); toast(`Emergency Kit: ${what} done`); });
ACT['kit-go'] = () => { S.create.verify = ''; S.create.err = ''; push('create-verify'); };
SCREENS['create-verify'] = {
  render: () => frame(nav({ back: 'Emergency Kit', title: 'Check your kit', always: true }), `<p class="step">Step 4 of 4</p><h1 class="lt2">Check that you saved it</h1><p class="sub" style="margin-top:8px">Open your saved Emergency Kit and type the last group of the Secret Key, the four characters after the final dash.</p>
    <div class="fld"><label class="label" for="vk">Last group of your Secret Key <span class="req">(required)</span></label><input class="input mono${S.create.err ? ' err' : ''}" id="vk" data-bind="create.verify" maxlength="4" autocomplete="off" autocapitalize="characters" spellcheck="false" value="${esc(S.create.verify)}" aria-describedby="vk-e" ${S.create.busy ? 'disabled' : ''}><div id="vk-e">${S.create.err ? errmsg('vk-err', S.create.err) : ''}</div></div>`,
    { foot: `<button type="button" class="btn${S.create.busy ? ' loading' : ''}" id="vk-go" data-act="vk-go" data-fk="vk-go"${S.create.verify.length === 4 && !S.create.busy ? '' : ' disabled'}>${S.create.busy ? ic('sync', 20) + 'Creating vault' : 'Create vault'}</button>` }),
  onInput: (el) => { S.create.verify = el.value.toUpperCase(); el.value = S.create.verify; S.create.err = ''; $('#vk-e').innerHTML = ''; el.classList.remove('err'); $('#vk-go').disabled = S.create.verify.length !== 4; }
};
ACT['vk-go'] = () => {
  if (S.create.verify !== KEY[5]) { S.create.err = "That doesn't match the last group of your Secret Key. Check your saved Emergency Kit and try again."; render(); $('#vk').focus(); return; }
  S.create.busy = true; render(); announce('Creating vault');
  setTimeout(() => { S.create.busy = false; S.items = []; S.deleted = []; S.sync = 'syncing'; reset('list'); startSync(); }, dur(1400));
};

/* ================= 4 Unlock ================= */
SCREENS.unlock = {
  render: () => {
    const u = S.unlock, locked = u.fails >= 3;
    return frame(nav({}), `<div class="hero center" style="padding-top:24px">${logo(72)}<h1 class="lt2" style="margin-top:12px">FigLock is locked</h1><p class="sub" style="margin-bottom:0">${esc(S.vaultName)}</p></div>
      <div class="stack4" style="margin-top:28px">
        ${locked ? `<div class="notice bad">${ic('lock', 20)}<div><b>Password entry is paused.</b><br>Too many wrong passwords. You can try again at 9:46 AM. Face ID still works.</div></div>` : ''}
        <button type="button" class="btn" data-act="un-face" data-fk="un-face">${ic('fingerprint', 22)}Unlock with Face ID</button>
        ${u.pw || u.err || locked ? `<div class="fld"><label class="label" for="up">Password</label><div class="pwrow"><input class="input${u.err ? ' err' : ''}" id="up" type="password" autocomplete="current-password" data-bind="unlock.val" aria-describedby="up-e"${locked ? ' disabled' : ''}><button type="button" class="iconbtn" data-act="un-eye" data-fk="un-eye" aria-label="Show password" aria-pressed="false"${locked ? ' disabled' : ''}>${ic('eye', 22)}</button></div><div id="up-e">${u.err && !locked ? errmsg('up-err', u.err) : ''}</div></div>
          <button type="button" class="btn secondary" data-act="un-pw" data-fk="un-pw"${locked ? ' disabled' : ''}>Unlock with password</button>` : `<button type="button" class="btn plain" data-act="un-showpw" data-fk="un-showpw">Use password</button>`}
        ${locked ? `<button type="button" class="btn plain" data-act="un-remove" data-fk="un-remove">Forgot it? Remove this vault from this iPhone</button>` : ''}
      </div>`)
  }
};
ACT['un-face'] = () => faceId('Unlock FigLock', () => { S.unlock = { fails: 0, pw: false, err: '' }; reset('list'); });
ACT['un-showpw'] = () => { S.unlock.pw = true; render(); $('#up').focus(); };
ACT['un-eye'] = (el) => { const on = el.getAttribute('aria-pressed') !== 'true'; el.setAttribute('aria-pressed', on); el.setAttribute('aria-label', on ? 'Hide password' : 'Show password'); $('#up').type = on ? 'text' : 'password'; el.innerHTML = ic(on ? 'eyeOff' : 'eye', 22); };
ACT['un-pw'] = () => {
  const v = $('#up').value;
  if (v === SAMPLE_PW) { S.unlock = { fails: 0, pw: false, err: '' }; reset('list'); return; }
  S.unlock.fails++; S.unlock.pw = true;
  S.unlock.err = S.unlock.fails >= 3 ? '' : `That password isn't right. Check it and try again. ${3 - S.unlock.fails} ${3 - S.unlock.fails === 1 ? 'try' : 'tries'} left before FigLock pauses password entry.`;
  render(); if (S.unlock.fails < 3) $('#up').focus();
};
ACT['un-remove'] = () => ACT['remove-vault']();

/* ================= search ================= */
function lev(a, b) {
  const m = a.length, n = b.length; if (!m) return n; if (!n) return m;
  let prev = Array.from({ length: n + 1 }, (_, j) => j);
  for (let i = 1; i <= m; i++) { const cur = [i]; for (let j = 1; j <= n; j++) cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1)); prev = cur; }
  return prev[n];
}
/* Matching reads names, aliases, domains and tags only. Secret values are never searched or shown. */
function matchItem(it, q) {
  const s = q.trim().toLowerCase(); if (!s) return { text: '' };
  if (it.name.toLowerCase().includes(s)) return { text: 'Matches name' };
  if (it.alias.includes(s)) return { text: `Matches alias "${it.alias}"` };
  if (it.domain.includes(s)) return { text: `Matches domain ${it.domain}` };
  const tag = it.tags.find((t) => t.includes(s)); if (tag) return { text: `Matches tag "${tag}"` };
  if (s.length >= 3) {
    const words = [...it.name.toLowerCase().split(/[^a-z0-9]+/), it.alias, ...it.domain.split(/[^a-z0-9]+/)].filter((w) => w.length >= 3);
    const max = s.length >= 6 ? 2 : 1; const hit = words.find((w) => lev(s, w) <= max);
    if (hit) return { text: `Typo-corrected to "${hit}"`, typo: true, word: hit };
  }
  return null;
}
const visible = () => S.items.filter((i) => S.filter === 'all' || i.type === S.filter).map((it) => ({ it, m: matchItem(it, S.q) })).filter((x) => x.m).sort((a, b) => a.it.name.localeCompare(b.it.name));

/* ================= 5 Vault list ================= */
function rowHtml(x) {
  const { it, m } = x;
  return `<div class="swipe" data-id="${it.id}"><div class="swipe-actions"><button type="button" data-act="row-copy" data-arg="${it.id}" aria-label="Copy ${it.type === 'login' ? 'password' : 'secret'} for ${esc(it.name)}">${ic('copy', 20)}<span>Copy</span></button><button type="button" class="d" data-act="row-del" data-arg="${it.id}" aria-label="Delete ${esc(it.name)}">${ic('trash', 20)}<span>Delete</span></button></div>
  <button type="button" class="cell row" data-act="open-item" data-arg="${it.id}" data-fk="item-${it.id}" aria-label="${esc(it.name)}, ${esc(it.sub)}${m.text ? '. ' + esc(m.text) : ''}"><span class="tile">${ic(TYPE_ICON[it.type], 20)}</span><span class="grow"><span class="t b od-truncate">${esc(it.name)}</span><span class="s od-truncate">${esc(it.sub)}</span>${m.text ? `<span class="why"><span class="badge">${ic('search', 12)}${esc(m.text)}</span></span>` : ''}</span>${ic('chevR', 16, 'chev')}</button></div>`;
}
function resultsHtml() {
  if (!S.items.length) return `<div class="empty"><span class="tile xl">${ic('lock', 34)}</span><h2>Your vault is empty</h2><p>Add your first login, API token or document. Items you add are encrypted on this iPhone.</p><button type="button" class="btn" data-act="add-item" data-fk="empty-add">${ic('plus', 20)}Add an item</button></div>`;
  const list = visible();
  if (!list.length) return `<div class="empty"><span class="tile xl">${ic('search', 34)}</span><h2>${S.q.trim() ? `No items match “${esc(S.q.trim())}”` : 'Nothing in this filter yet'}</h2><p>${S.q.trim() ? 'Check the spelling, or try an alias or a domain.' : 'Add one, or switch back to All.'}</p><button type="button" class="btn secondary" data-act="${S.q.trim() ? 'clear-search' : 'filter'}" data-arg="all" data-fk="clear-search">${S.q.trim() ? 'Clear search' : 'Show all items'}</button></div>`;
  const typo = list.find((x) => x.m.typo); const q = S.q.trim();
  const meta = !q ? `${list.length} ${list.length === 1 ? 'item' : 'items'}` : typo ? `Showing results for “${typo.m.word}”. You typed “${q}”.` : `${list.length} ${list.length === 1 ? 'result' : 'results'}`;
  return `<p class="meta" role="status">${esc(meta)}</p><div class="group">${list.map(rowHtml).join('')}</div>`;
}
const syncInfo = () => ({
  synced: { cls: 'ok', icon: 'okc', chip: 'Synced', cap: 'Last synced 9:41 AM' },
  syncing: { cls: 'busy', icon: 'sync', chip: 'Syncing', cap: 'Checking for changes' },
  notsynced: { cls: 'warn', icon: 'warn', chip: 'Not synced', cap: 'Last synced yesterday at 6:48 PM' },
  offline: { cls: 'off', icon: 'wifiOff', chip: 'Offline', cap: "Changes save here and sync when you're back online. Last synced 9:12 AM." }
}[S.sync]);
SCREENS.list = {
  tab: 'vault',
  initScroll: () => (S.searching || S.q ? 0 : ($('.sb') ? $('.sb').offsetHeight + 12 : 0)),
  render: () => {
    const si = syncInfo(), q = S.req.status === 'pending';
    const banners = `${q ? `<button type="button" class="banner" data-act="open-agent" data-fk="banner-agent"><span class="tile agent">${ic('bot', 22)}</span><span class="grow"><span class="t">Claude Code is asking to use GitHub token</span><span class="s">Review the request. Nothing is shared until you approve.</span></span>${ic('chevR', 16, 'chev')}</button>` : ''}
      ${S.driveAlert ? `<button type="button" class="banner warn" data-act="goto" data-arg="err-drive-expired" data-fk="banner-drive"><span class="tile warn">${ic('warn', 22)}</span><span class="grow"><span class="t">Google Drive sign-in expired</span><span class="s">Sync is paused. Sign in again to continue.</span></span>${ic('chevR', 16, 'chev')}</button>` : ''}
      ${!S.folderOk ? `<button type="button" class="banner warn" data-act="goto" data-arg="err-folder-missing" data-fk="banner-folder"><span class="tile warn">${ic('folder', 22)}</span><span class="grow"><span class="t">Can't find your vault folder</span><span class="s">Sync is paused. Choose how to recover.</span></span>${ic('chevR', 16, 'chev')}</button>` : ''}`;
    return frame(nav({ title: 'Vault', large: true, right: `<button type="button" class="navbtn" data-act="go-search" data-fk="go-search" aria-label="Search vault">${ic('search', 22)}</button><button type="button" class="navbtn" data-act="add-item" data-fk="nav-add" aria-label="Add item">${ic('plus', 24)}</button>` }),
      `<div class="sb"><label class="sb-field" for="q">${ic('search', 18)}<span class="sr-only">Search vault</span><input class="sb-in" id="q" type="search" data-fk="q" data-bind="q" placeholder="Search names, aliases, domains" autocomplete="off" autocapitalize="none" spellcheck="false" value="${esc(S.q)}"></label>${S.searching || S.q ? `<button type="button" class="navbtn" data-act="cancel-search" data-fk="cancel-search">Cancel</button>` : ''}</div>
       <h1 class="lt">Vault</h1>
       <div class="syncrow"><button type="button" class="syncchip ${si.cls}" data-act="sync-sheet" data-fk="sync-chip" aria-label="Sync status: ${si.chip}. ${esc(si.cap)}. Tap for details.">${ic(si.icon, 18)}<span>${si.chip}</span></button><span class="synccap">${esc(si.cap)}</span></div>
       ${banners}
       ${S.items.length ? `<div class="rail" role="group" aria-label="Filter items">${FILTERS.map(([v, l]) => `<button type="button" class="chip" aria-pressed="${S.filter === v}" data-act="filter" data-arg="${v}" data-fk="f-${v}">${l}</button>`).join('')}</div>` : ''}
       <div id="results">${resultsHtml()}</div>
       ${S.items.length && !S.q ? `<div class="group" style="margin-top:20px"><button type="button" class="cell" data-act="goto" data-arg="deleted" data-fk="to-deleted"><span class="tile">${ic('trash', 20)}</span><span class="grow"><span class="t">Recently deleted</span></span><span class="v">${S.deleted.length}</span>${ic('chevR', 16, 'chev')}</button></div>` : ''}`,
      { tab: 'vault', collapse: 110, cls: S.searching || S.q ? 'searching' : '' });
  },
  onInput: (el) => { if (el.id !== 'q') return; S.q = el.value; S.searching = true; $('.screen').classList.add('searching'); $('#results').innerHTML = resultsHtml(); const cs = $('#main'); if (cs) cs.scrollTop = 0; }
};
ACT.goto = (el, id) => push(id);
ACT['go-search'] = () => { S.searching = true; render(); const sc = $('#main'); if (sc) sc.scrollTop = 0; $('#q').focus(); };
ACT['cancel-search'] = () => { S.q = ''; S.searching = false; render(); const sc = $('#main'); if (sc && $('.sb')) sc.scrollTop = $('.sb').offsetHeight + 12; };
ACT['clear-search'] = () => { S.q = ''; S.searching = false; render(); };
ACT.filter = (el, v) => { S.filter = v; render(); };
ACT['open-item'] = (el, id) => { const w = el.closest('.swipe'); if (w && w.classList.contains('open')) { w.classList.remove('open'); return; } push('detail', { item: id }); };
ACT['row-copy'] = (el, id) => { S.copied = { key: id + ':secret', until: Date.now() + 30000 }; $$('.swipe.open').forEach((w) => w.classList.remove('open')); toast('Copied. The clipboard clears in 30 s'); };
ACT['row-del'] = (el, id) => confirmDelete(id);
ACT['open-agent'] = () => openSheet('agent');

/* Sync */
let syncT = null;
function startSync() { clearTimeout(syncT); S.sync = 'syncing'; if (SCREENS[top().id]) render(); syncT = setTimeout(() => { if (S.sync === 'syncing') { S.sync = 'synced'; render(); announce('Vault synced'); } }, dur(1800)); }
SHEETS['sync-status'] = () => {
  const si = syncInfo();
  const why = { synced: 'Your vault is up to date with ' + (S.syncProvider === 'icloud' ? 'iCloud Drive' : 'Google Drive') + '.', syncing: 'FigLock is checking for changes. You can keep using your vault.', notsynced: "The last attempt didn't finish, so changes made on other devices may not be here yet. Your items on this iPhone are safe.", offline: "This iPhone has no connection. Everything you change is saved here and goes up when you're back online." }[S.sync];
  return { title: 'Sync status', body: `<div class="notice ${si.cls === 'ok' ? 'ok' : si.cls === 'warn' ? 'warn' : ''}">${ic(si.icon, 20)}<div><b>${si.chip}</b><br>${esc(why)}</div></div><div class="group"><div class="kv"><span class="k">Sync location</span><span class="val">${S.syncProvider === 'icloud' ? 'iCloud Drive - FigLock folder' : 'Google Drive'}</span></div><div class="kv"><span class="k">Last synced</span><span class="val">${S.sync === 'notsynced' ? 'Yesterday at 6:48 PM' : S.sync === 'offline' ? 'Today at 9:12 AM' : 'Today at 9:41 AM'}</span></div></div>`,
    foot: `<button type="button" class="btn" data-act="sync-now" data-fk="sync-now">${ic('sync', 20)}${S.sync === 'offline' ? 'Try again' : 'Sync now'}</button><button type="button" class="btn secondary" data-act="sync-to-settings" data-fk="sync-settings">Sync settings</button>` };
};
ACT['sync-sheet'] = () => openSheet('sync-status');
ACT['sync-now'] = () => { if (S.sync === 'offline') { toast('Still offline. FigLock will try again when you reconnect.'); return; } closeOv(() => startSync()); };
ACT['sync-to-settings'] = () => closeOv(() => { selectTab('settings'); push('sync-setup'); });

/* New item */
SHEETS['new-item'] = () => ({ title: 'New item', body: `<div class="group">${['login', 'token', 'doc'].map((t) => `<button type="button" class="cell" data-act="new-of" data-arg="${t}" data-fk="new-${t}"><span class="tile">${ic(TYPE_ICON[t], 22)}</span><span class="grow"><span class="t b">${TYPE_NAME[t]}</span><span class="s">${{ login: 'A website, its username and password.', token: 'An API key or access token for a service.', doc: 'A certificate, key file or other document.' }[t]}</span></span>${ic('chevR', 16, 'chev')}</button>`).join('')}</div>` });
ACT['add-item'] = () => openSheet('new-item');
ACT['new-of'] = (el, t) => closeOv(() => openEdit(null, t));

/* Context menu, swipe, long press */
function ctxMenu(id) {
  const it = itemById(id); if (!it) return;
  const items = [{ label: 'Open', icon: 'chevR', run: () => push('detail', { item: id }) }];
  if (it.type === 'login') items.push({ label: 'Copy username', icon: 'person', run: () => toast('Username copied') });
  items.push({ label: it.type === 'login' ? 'Copy password' : it.type === 'token' ? 'Copy token' : 'Copy certificate password', icon: 'copy', run: () => { S.copied = { key: id + ':secret', until: Date.now() + 30000 }; toast('Copied. The clipboard clears in 30 s'); } });
  items.push({ label: 'Edit', icon: 'pencil', run: () => openEdit(id) }, { label: 'Delete', icon: 'trash', danger: true, run: () => confirmDelete(id) });
  openOv({ type: 'menu', title: it.name, items });
}
let swp = null, lp = null, noClick = false;
function wireGestures(root) {
  root.addEventListener('pointerdown', (e) => {
    const r = e.target.closest('.swipe .row'); if (!r) return;
    swp = { w: r.parentElement, r, x: e.clientX, y: e.clientY, moved: false, open: r.parentElement.classList.contains('open'), t: 0 };
    clearTimeout(lp); lp = setTimeout(() => { if (swp && !swp.moved) { noClick = true; ctxMenu(swp.w.dataset.id); swp = null; } }, 600);
  });
  root.addEventListener('pointermove', (e) => {
    if (!swp) return; const dx = e.clientX - swp.x, dy = e.clientY - swp.y;
    if (!swp.moved && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) { swp.moved = true; clearTimeout(lp); swp.w.classList.add('dragging'); }
    if (Math.abs(dy) > 12 && !swp.moved) { clearTimeout(lp); swp = null; return; }
    if (swp && swp.moved) { swp.t = Math.max(-176, Math.min(0, (swp.open ? -176 : 0) + dx)); swp.r.style.transform = `translateX(${swp.t}px)`; }
  });
  const end = () => {
    clearTimeout(lp); if (!swp) return;
    if (swp.moved) { const open = swp.t < -70; swp.w.classList.remove('dragging'); swp.r.style.transform = ''; $$('.swipe.open').forEach((x) => { if (x !== swp.w) x.classList.remove('open'); }); swp.w.classList.toggle('open', open); noClick = true; setTimeout(() => { noClick = false; }, 50); }
    swp = null;
  };
  root.addEventListener('pointerup', end); root.addEventListener('pointercancel', end);
  root.addEventListener('contextmenu', (e) => { const r = e.target.closest('.swipe .row'); if (r) { e.preventDefault(); ctxMenu(r.parentElement.dataset.id); } });
}

/* Delete + restore */
function confirmDelete(id) {
  const it = itemById(id); if (!it) return;
  alertDlg(`Delete “${it.name}”?`, 'It moves to Recently deleted for 30 days. You can restore it from there.', [cancelBtn, { label: 'Delete', style: 'destructive', run: () => {
    S.items = S.items.filter((i) => i.id !== id); S.deleted.unshift({ ...it, gone: 'Deleted just now, removed for good in 30 days' });
    if (top().id === 'detail' || top().id === 'edit') { S.stack = S.stack.filter((s) => s.id !== 'detail' && s.id !== 'edit'); if (!S.stack.length) S.stack = [{ id: 'list' }]; }
    render(); toast(`“${it.name}” deleted`, { label: 'Undo', run: () => restoreItem(id, true) });
  } }]);
}
function restoreItem(id, quiet) {
  const i = S.deleted.findIndex((d) => d.id === id); if (i < 0) return;
  const [it] = S.deleted.splice(i, 1); delete it.gone; S.items.push(it); render(); if (!quiet) toast(`“${it.name}” restored`); else toast(`“${it.name}” is back in your vault`);
}
SCREENS.deleted = {
  tab: 'vault',
  render: () => frame(nav({ back: 'Vault', title: 'Recently deleted', large: true }), `<h1 class="lt">Recently deleted</h1>
    ${S.deleted.length ? `<p class="sub">Items stay here for 30 days, then FigLock removes them for good.</p><div class="group">${S.deleted.map((d) => `<div class="kv" style="gap:12px"><div style="display:flex;gap:12px;align-items:center"><span class="tile">${ic(TYPE_ICON[d.type], 20)}</span><span class="grow" style="display:grid;gap:2px;min-width:0"><span style="font-weight:600;overflow-wrap:anywhere">${esc(d.name)}</span><span class="hint">${esc(d.gone)}</span></span></div><div class="sf-actions"><button type="button" class="btn-sm" data-act="restore" data-arg="${d.id}" data-fk="rs-${d.id}" aria-label="Restore ${esc(d.name)}">${ic('undo', 18)}<span>Restore</span></button><button type="button" class="btn-sm danger" data-act="purge" data-arg="${d.id}" data-fk="pg-${d.id}" aria-label="Delete ${esc(d.name)} forever">${ic('trash', 18)}<span>Delete forever</span></button></div></div>`).join('')}</div>`
      : `<div class="empty"><span class="tile xl">${ic('tray', 34)}</span><h2>Nothing deleted lately</h2><p>Items you delete wait here for 30 days, so you can bring them back.</p><button type="button" class="btn secondary" data-act="back" data-fk="empty-back">Back to vault</button></div>`}`, { tab: 'vault' })
};
ACT.restore = (el, id) => restoreItem(id);
ACT.purge = (el, id) => { const it = itemById(id); alertDlg(`Delete “${it.name}” forever?`, "This can't be undone. FigLock removes it from every device.", [cancelBtn, { label: 'Delete forever', style: 'destructive', run: () => { S.deleted = S.deleted.filter((d) => d.id !== id); render(); toast(`“${it.name}” deleted forever`); } }]); };

/* ================= 6 Item detail ================= */
const kv = (k, v, cls = '') => `<div class="kv"><span class="k">${k}</span><span class="val ${cls}">${v}</span></div>`;
SCREENS.detail = {
  tab: 'vault',
  render: (t) => {
    const it = itemById(t.item); const key = it.id + ':secret'; let body = '';
    if (it.type === 'login') body = `<div class="group"><div class="kvrow">${kv('Username', esc(it.user))}<button type="button" class="btn-sm" data-act="copy-plain" data-arg="Username" data-fk="cu" aria-label="Copy username">${ic('copy', 18)}<span>Copy</span></button></div>${secretField(key, 'Password')}${kv('Website', esc(it.site), 'link')}${it.notes ? kv('Notes', esc(it.notes)) : ''}</div>`;
    else if (it.type === 'token') body = `<div class="group">${secretField(key, 'Token')}${kv('Scopes', esc(it.scopes))}${kv('Created', esc(it.updated.replace('Created ', '')))}</div>
      <p class="ghead">Agent access</p><div class="notice agent">${ic('bot', 20)}<div><b>Agents can use this token only on:</b><div class="hosts" style="margin-top:8px">${it.hosts.map((h) => `<span class="host">${esc(h)}</span>`).join('')}</div><p class="hint" style="margin-top:8px">Each use needs your approval with Face ID.</p></div></div>`;
    else body = `<div class="group"><div class="filebox"><span class="tile big">${ic('doc', 26)}</span><span class="grow" style="display:grid;gap:2px;min-width:0"><span style="font-weight:600;overflow-wrap:anywhere" class="mono">${esc(it.file.name)}</span><span class="hint">${esc(it.file.kind)} - ${esc(it.file.size)}</span></span></div><div style="padding:0 16px 12px"><button type="button" class="btn-sm" data-act="export-file" data-fk="export">${ic('share', 18)}<span>Save to Files</span></button></div>${secretField(key, 'Certificate password')}</div>
      <p class="gfoot">Saving the file out of FigLock needs Face ID. Anyone with the file and its password can use the certificate.</p>`;
    return frame(nav({ back: 'Vault', title: it.name, right: `<button type="button" class="navbtn bold" data-act="edit-item" data-arg="${it.id}" data-fk="edit-btn">Edit</button>` }),
      `<div style="display:flex;gap:16px;align-items:center;padding:8px 0 20px"><span class="tile big">${ic(TYPE_ICON[it.type], 28)}</span><div style="min-width:0"><h1 class="lt2">${esc(it.name)}</h1><p class="hint" style="margin-top:2px;overflow-wrap:anywhere">${esc(it.sub)}</p></div></div>${body}
      <p class="gfoot" style="margin-top:12px">${esc(it.updated)}</p>
      <div class="group" style="margin-top:20px"><button type="button" class="cell danger" data-act="del-item" data-arg="${it.id}" data-fk="del-item">${ic('trash', 20, 'i-bad')}<span class="grow"><span class="t">Delete item</span></span></button></div>`, { tab: 'vault', collapse: 60 });
  }
};
ACT['edit-item'] = (el, id) => openEdit(id);
ACT['del-item'] = (el, id) => confirmDelete(id);
ACT['export-file'] = () => faceId('Save the certificate file out of FigLock', () => toast('Saved to Files: figlock-demo-signing.p12'));

/* ================= 7 Edit + generator ================= */
function openEdit(id, type) {
  const it = id ? itemById(id) : null;
  S.edit = it ? { id, type: it.type, name: it.name, user: it.user || '', secret: it.secret, site: it.site || '', notes: it.notes || '', hosts: (it.hosts || []).join(', '), scopes: it.scopes || '', showpw: false, err: '', dirty: false }
    : { id: null, type, name: '', user: '', secret: '', site: '', notes: '', hosts: '', scopes: '', showpw: false, err: '', dirty: false };
  push('edit');
}
const fldInput = (id, label, bind, val, o = {}) => `<div class="fld"><label class="label" for="${id}">${label}${o.req ? ' <span class="req">(required)</span>' : ''}</label>${o.area ? `<textarea class="input" id="${id}" data-bind="${bind}" rows="3">${esc(val)}</textarea>` : `<input class="input${o.mono ? ' mono' : ''}" id="${id}" data-bind="${bind}" value="${esc(val)}" autocomplete="off" autocapitalize="none" spellcheck="false"${o.describedby ? ` aria-describedby="${o.describedby}"` : ''}>`}${o.help ? `<p class="hint">${o.help}</p>` : ''}</div>`;
SCREENS.edit = {
  render: () => {
    const e = S.edit, isNew = !e.id, ty = e.type;
    const secretLabel = ty === 'login' ? 'Password' : ty === 'token' ? 'Token' : 'Certificate password';
    const f = [`<div class="fld"><label class="label" for="e-name">Name <span class="req">(required)</span></label><input class="input${e.err ? ' err' : ''}" id="e-name" data-bind="edit.name" value="${esc(e.name)}" autocomplete="off" aria-describedby="e-name-e"><div id="e-name-e">${e.err ? errmsg('e-name-err', e.err) : ''}</div></div>`];
    if (ty === 'login') f.push(fldInput('e-user', 'Username', 'edit.user', e.user));
    f.push(`<div class="fld"><label class="label" for="e-sec">${secretLabel}</label><div class="pwrow"><input class="input mono" id="e-sec" data-bind="edit.secret" type="${e.showpw ? 'text' : 'password'}" value="${esc(e.secret)}" autocomplete="off" spellcheck="false"><button type="button" class="iconbtn" data-act="e-eye" data-fk="e-eye" aria-label="${e.showpw ? 'Hide' : 'Show'} ${secretLabel.toLowerCase()}" aria-pressed="${e.showpw}">${ic(e.showpw ? 'eyeOff' : 'eye', 22)}</button></div>${ty === 'login' ? `<button type="button" class="btn secondary" style="margin-top:8px" data-act="open-gen" data-fk="open-gen">${ic('sync', 20)}Generate a password</button>` : ''}</div>`);
    if (ty === 'login') f.push(fldInput('e-site', 'Website', 'edit.site', e.site, { help: 'Used to match this item in AutoFill.' }));
    if (ty === 'token') { f.push(fldInput('e-hosts', 'Allowed hosts', 'edit.hosts', e.hosts, { mono: true, help: 'Separate with commas. Agents can use this token only on these hosts.' })); f.push(fldInput('e-scopes', 'Scopes', 'edit.scopes', e.scopes)); }
    if (ty === 'doc') f.push(`<div class="fld"><span class="label">File</span><div class="group"><div class="filebox"><span class="tile">${ic('doc', 22)}</span><span class="grow" style="display:grid;gap:2px;min-width:0"><span class="mono" style="overflow-wrap:anywhere">${esc(e.id ? itemById(e.id).file.name : 'No file chosen')}</span></span></div></div><button type="button" class="btn secondary" data-act="e-file" data-fk="e-file">${ic('folder', 20)}Choose file</button></div>`);
    f.push(fldInput('e-notes', 'Notes', 'edit.notes', e.notes, { area: true }));
    return frame(nav({ always: true, title: isNew ? 'New ' + TYPE_NAME[ty].toLowerCase() : 'Edit item', left: `<button type="button" class="navbtn" data-act="edit-cancel" data-fk="edit-cancel">Cancel</button>`, right: `<button type="button" class="navbtn bold" data-act="edit-save" data-fk="edit-save">Save</button>` }),
      `<div class="stack4" style="padding-top:12px">${f.join('')}${!isNew ? `<div class="group" style="margin-top:12px"><button type="button" class="cell danger" data-act="del-item" data-arg="${e.id}" data-fk="edit-del">${ic('trash', 20, 'i-bad')}<span class="grow"><span class="t">Delete item</span></span></button></div>` : ''}</div>`);
  },
  onInput: (el) => { S.edit.dirty = true; if (el.id === 'e-name') { S.edit.err = ''; $('#e-name-e').innerHTML = ''; el.classList.remove('err'); } },
  onBlur: (el) => { if (el.id === 'e-name' && !S.edit.name.trim()) { S.edit.err = 'Give this item a name so you can find it later.'; $('#e-name-e').innerHTML = errmsg('e-name-err', S.edit.err); el.classList.add('err'); } }
};
ACT['e-eye'] = () => { S.edit.showpw = !S.edit.showpw; render(); };
ACT['e-file'] = () => toast('The system file picker opens here');
ACT['edit-cancel'] = () => { if (!S.edit.dirty) { back(); return; } alertDlg('Discard changes?', 'The edits to this item have not been saved.', [{ label: 'Keep editing', style: 'bold' }, { label: 'Discard', style: 'destructive', run: () => back() }]); };
ACT['edit-save'] = () => {
  const e = S.edit;
  if (!e.name.trim()) { e.err = 'Give this item a name so you can find it later.'; render(); $('#e-name').focus(); return; }
  if (e.id) { const it = S.items.find((i) => i.id === e.id); Object.assign(it, { name: e.name.trim(), user: e.user, secret: e.secret, site: e.site, notes: e.notes, scopes: e.scopes, hosts: e.hosts ? e.hosts.split(',').map((h) => h.trim()).filter(Boolean) : it.hosts, sub: it.type === 'login' ? (e.user || it.sub) : it.sub, updated: 'Edited just now' }); }
  else { const id = 'n' + Date.now(); S.items.push({ id, type: e.type, name: e.name.trim(), sub: e.type === 'login' ? (e.user || 'Login') : TYPE_NAME[e.type], alias: e.name.trim().toLowerCase().slice(0, 3), domain: e.site || 'example.com', user: e.user, secret: e.secret || 'fl_demo_new_0000', site: e.site, notes: e.notes, hosts: e.hosts ? e.hosts.split(',').map((h) => h.trim()) : [], scopes: e.scopes, file: { name: 'new-file.bin', size: '1 KB', kind: 'File' }, tags: [], updated: 'Created just now' }); }
  const nm = e.name.trim(); S.edit = null; back(); toast(`Saved “${nm}”`);
};

const WORDS = ['maple', 'orbit', 'lantern', 'quartz', 'meadow', 'harbor', 'birch', 'signal', 'copper', 'tidal', 'ember', 'pine', 'cobalt', 'river', 'falcon', 'willow', 'summit', 'canyon', 'juniper', 'marble', 'saffron', 'thistle', 'violet', 'walnut'];
const GEN = { mode: 'random', len: 20, upper: true, lower: true, digits: true, symbols: true, avoid: true, words: 4, value: '' };
function genValue(g) {
  const rnd = (n) => { const a = new Uint32Array(1); crypto.getRandomValues(a); return a[0] % n; };
  if (g.mode === 'words') return Array.from({ length: g.words }, () => WORDS[rnd(WORDS.length)]).join('-');
  const sets = [];
  const U = g.avoid ? 'ABCDEFGHJKLMNPQRSTUVWXYZ' : 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', L = g.avoid ? 'abcdefghijkmnopqrstuvwxyz' : 'abcdefghijklmnopqrstuvwxyz', D = g.avoid ? '23456789' : '0123456789', Y = '!@#$%^&*-_=+?';
  if (g.upper) sets.push(U); if (g.lower) sets.push(L); if (g.digits) sets.push(D); if (g.symbols) sets.push(Y);
  const pool = sets.join(''); const out = sets.map((s) => s[rnd(s.length)]);
  while (out.length < g.len) out.push(pool[rnd(pool.length)]);
  for (let i = out.length - 1; i > 0; i--) { const j = rnd(i + 1);[out[i], out[j]] = [out[j], out[i]]; }
  return out.slice(0, g.len).join('');
}
const regen = () => { GEN.value = genValue(GEN); };
regen();
const genStrength = () => (GEN.mode === 'words' ? (GEN.words >= 4 ? ['Strong', 'ok'] : ['Okay', 'warn']) : GEN.len >= 16 ? ['Strong', 'ok'] : GEN.len >= 12 ? ['Okay', 'warn'] : ['Weak', 'bad']);
SHEETS.generator = () => {
  const st = genStrength();
  const tog = (k, l) => `<div class="cell" style="cursor:default"><span class="grow"><span class="t">${l}</span></span><span class="v">${GEN[k] ? 'On' : 'Off'}</span>${sw(GEN[k], 'gen-tog', l, k)}</div>`;
  return { title: 'Password generator', body: `<div><div class="gen" id="gen-val" aria-label="Generated password">${esc(GEN.value)}</div><div class="mtxt i-${st[1]}" id="gen-st" style="margin-top:8px">${ic(st[1] === 'ok' ? 'okc' : 'warn', 16)}<span>${st[0]}</span></div></div>
    <button type="button" class="btn secondary" data-act="gen-new" data-fk="gen-new">${ic('sync', 20)}Generate another</button>
    ${seg('Type', [['random', 'Characters'], ['words', 'Words']], GEN.mode, 'gen-mode')}
    ${GEN.mode === 'random' ? `<div class="fld"><label class="label" for="gen-len">Length: <span id="gen-lenv">${GEN.len}</span> characters</label><input class="range" id="gen-len" type="range" min="8" max="64" value="${GEN.len}" data-bind="gen.len"></div><div class="group">${tog('upper', 'Uppercase letters')}${tog('lower', 'Lowercase letters')}${tog('digits', 'Numbers')}${tog('symbols', 'Symbols')}${tog('avoid', 'Avoid look-alikes (0 O l 1)')}</div>`
      : `<div class="fld"><label class="label" for="gen-words">Words: <span id="gen-wordsv">${GEN.words}</span></label><input class="range" id="gen-words" type="range" min="3" max="8" value="${GEN.words}" data-bind="gen.words"></div>`}`,
    foot: `<button type="button" class="btn" data-act="gen-use" data-fk="gen-use">Use this password</button>` };
};
SHEETS.generator.onInput = (el) => {
  if (el.id === 'gen-len') GEN.len = Number(el.value); if (el.id === 'gen-words') GEN.words = Number(el.value);
  regen(); $('#gen-val').textContent = GEN.value; const lv = $('#gen-lenv'); if (lv) lv.textContent = GEN.len; const wv = $('#gen-wordsv'); if (wv) wv.textContent = GEN.words;
  const st = genStrength(); $('#gen-st').className = 'mtxt i-' + st[1]; $('#gen-st').innerHTML = ic(st[1] === 'ok' ? 'okc' : 'warn', 16) + `<span>${st[0]}</span>`;
};
ACT['open-gen'] = () => { regen(); openSheet('generator'); };
ACT['gen-new'] = () => { regen(); renderOv(); announce('New password generated'); };
ACT['gen-mode'] = (el, v) => { GEN.mode = v; regen(); renderOv(); };
ACT['gen-tog'] = (el, k) => { const on = ['upper', 'lower', 'digits', 'symbols'].filter((x) => GEN[x]); if (['upper', 'lower', 'digits', 'symbols'].includes(k) && GEN[k] && on.length === 1) { toast('Keep at least one character type on'); return; } GEN[k] = !GEN[k]; regen(); renderOv(); };
ACT['gen-use'] = () => closeOv(() => { if (S.edit) { S.edit.secret = GEN.value; S.edit.dirty = true; S.edit.showpw = false; render(); } toast('Password added. Save the item to keep it.'); });

/* ================= Agents tab ================= */
SCREENS.agents = {
  tab: 'agents',
  render: () => {
    const q = S.req.status === 'pending';
    return frame(nav({ title: 'Agents', large: true }), `<h1 class="lt">Agents</h1><p class="sub">AI agents ask here before they use a secret. Teal always means an agent is involved.</p>
      <p class="ghead" style="margin-top:8px">Waiting for you</p>
      ${q ? `<div class="group"><button type="button" class="cell" data-act="open-agent" data-fk="ag-req"><span class="tile agent">${ic('bot', 22)}</span><span class="grow"><span class="t b">Claude Code</span><span class="s">Wants to ${S.req.mode === 'reveal' ? 'reveal' : 'use'} GitHub token for ${lenLabel(S.req.mins)}</span></span>${ic('chevR', 16, 'chev')}</button></div>` : `<div class="notice">${ic('info', 20)}<div>No requests are waiting. When an agent needs a secret, FigLock sends a notification.</div></div>`}
      <p class="ghead">Active grants</p>
      ${S.grants.length ? `<div class="group">${S.grants.map((g) => `<div class="kv" style="gap:12px"><div style="display:flex;gap:12px;align-items:center"><span class="tile agent">${ic('bot', 20)}</span><span style="display:grid;gap:2px;min-width:0"><span style="font-weight:600;overflow-wrap:anywhere">${esc(g.agent)} - ${esc(g.item)}</span><span class="hint">${esc(g.mode)}, ${esc(g.until)}</span></span></div><div class="sf-actions"><button type="button" class="btn-sm danger" data-act="revoke-grant" data-arg="${g.id}" data-fk="rg-${g.id}" aria-label="Revoke ${esc(g.agent)} access to ${esc(g.item)}">${ic('x', 18)}<span>Revoke</span></button></div></div>`).join('')}</div>` : `<div class="notice">${ic('info', 20)}<div>No active grants. Approved access shows up here and ends on its own.</div></div>`}
      <p class="ghead">Recent</p>
      <div class="group">${S.history.map((h) => `<div class="cell" style="cursor:default"><span class="tile ${h.ok ? 'ok' : 'bad'}">${ic(h.ok ? 'shield' : 'x', 20)}</span><span class="grow"><span class="t">${esc(h.text)}</span><span class="s">${esc(h.agent)} - ${esc(h.when)} - ${h.ok ? 'Approved' : 'Denied'}</span></span></div>`).join('')}</div>`, { tab: 'agents', collapse: 60 });
  }
};
ACT['revoke-grant'] = (el, id) => { const g = S.grants.find((x) => x.id === id); alertDlg(`Revoke ${g.agent}'s access to “${g.item}”?`, 'It stops working right away. The agent can ask again, and you will be asked each time.', [cancelBtn, { label: 'Revoke access', style: 'destructive', run: () => { S.grants = S.grants.filter((x) => x.id !== id); S.history.unshift({ id: 'r' + id, agent: g.agent, text: `Access to ${g.item} revoked`, when: 'Just now', ok: false }); render(); toast(`${g.agent} can no longer use “${g.item}”`); } }]); };

/* ================= 8 Settings ================= */
const syncLabel = () => (S.syncProvider === 'icloud' ? 'iCloud Drive' : 'Google Drive');
const link = (icon, t, v, act, arg = '', s = '') => `<button type="button" class="cell" data-act="${act}" data-arg="${arg}" data-fk="${act}${arg}"><span class="tile">${ic(icon, 20)}</span><span class="grow"><span class="t">${t}</span>${s ? `<span class="s">${s}</span>` : ''}</span>${v ? `<span class="v">${v}</span>` : ''}${ic('chevR', 16, 'chev')}</button>`;
SCREENS.settings = {
  tab: 'settings',
  render: () => frame(nav({ title: 'Settings', large: true }), `<h1 class="lt">Settings</h1>
    <div class="group"><div class="cell" style="cursor:default"><span class="tile big">${ic('lock', 26)}</span><span class="grow"><span class="t b">${esc(S.vaultName)}</span><span class="s od-truncate">${ME}</span></span></div></div>
    <p class="ghead">Security</p><div class="group">
      ${link('clock', 'Auto-lock', alLabel(S.settings.autolock), 'goto', 'autolock')}
      <div class="cell" style="cursor:default"><span class="tile">${ic('fingerprint', 20)}</span><span class="grow"><span class="t">Unlock with Face ID</span><span class="s">${S.settings.faceid ? 'On' : 'Off'}</span></span>${sw(S.settings.faceid, 'set-face', 'Unlock with Face ID')}</div>
      ${link('key', 'Secret Key and Emergency Kit', '', 'goto', 'secret-key')}
      <div class="cell" style="cursor:default"><span class="tile">${ic('copy', 20)}</span><span class="grow"><span class="t">Clipboard</span><span class="s">Copied secrets clear after 30 seconds.</span></span></div>
    </div>
    <p class="ghead">Vault</p><div class="group">
      ${link('laptop', 'Devices', String(S.devices.length), 'goto', 'devices')}
      ${link('sync', 'Sync', syncLabel(), 'goto', 'sync-setup')}
      ${link('trash', 'Recently deleted', String(S.deleted.length), 'goto', 'deleted')}
    </div>
    <p class="ghead">About</p><div class="group">${link('info', 'About FigLock', '', 'goto', 'about')}</div>
    <div class="stack" style="margin-top:24px"><button type="button" class="btn secondary" data-act="lock-now" data-fk="lock-now">${ic('lock', 20)}Lock FigLock now</button>
    <div class="group"><button type="button" class="cell danger" data-act="remove-vault" data-fk="remove-vault">${ic('out', 20, 'i-bad')}<span class="grow"><span class="t">Remove this vault from this iPhone</span><span class="s">Your items stay on your other devices.</span></span></button></div></div>`, { tab: 'settings' })
};
ACT['lock-now'] = () => reset('unlock');
ACT['remove-vault'] = () => alertDlg(`Remove “${S.vaultName}” from this iPhone?`, "Your items stay in your sync folder and on your other devices. To add the vault again you'll need your Secret Key and password.", [cancelBtn, { label: 'Remove vault', style: 'destructive', run: () => { const f = freshState(); Object.keys(f).forEach((k) => { S[k] = f[k]; }); reset('onboarding'); toast('Vault removed from this iPhone'); } }]);
SCREENS.autolock = {
  tab: 'settings',
  render: () => frame(nav({ back: 'Settings', title: 'Auto-lock' }), `<h1 class="lt2" style="margin:8px 0 8px">Auto-lock</h1><p class="sub">FigLock locks after you leave it for this long. It also locks when your iPhone locks.</p>
    <div class="group" role="radiogroup" aria-label="Auto-lock">${AUTOLOCKS.map(([v, l]) => `<button type="button" class="cell" role="radio" aria-checked="${S.settings.autolock === v}" data-act="set-autolock" data-arg="${v}" data-fk="al-${v}"><span class="grow"><span class="t">${l}</span></span>${S.settings.autolock === v ? ic('check', 20, 'check') : ''}</button>`).join('')}</div>
    <p class="gfoot">Shorter is safer. There is no "never" option.</p>`, { tab: 'settings' })
};
ACT['set-autolock'] = (el, v) => { S.settings.autolock = v; render(); announce(alLabel(v) + ' selected'); };
SCREENS.devices = {
  tab: 'settings',
  render: () => frame(nav({ back: 'Settings', title: 'Devices', large: true }), `<h1 class="lt">Devices</h1><p class="sub">These devices can open ${esc(S.vaultName)}. Revoke any you no longer use.</p>
    <div class="group">${S.devices.map((d) => `<button type="button" class="cell" data-act="device" data-arg="${d.id}" data-fk="dev-${d.id}"><span class="tile">${ic(d.kind, 22)}</span><span class="grow"><span class="t b">${esc(d.name)}</span><span class="s">${esc(d.meta)}</span>${d.current ? '<span class="why"><span class="badge ok">This iPhone</span></span>' : ''}</span>${ic('chevR', 16, 'chev')}</button>`).join('')}</div>
    <p class="gfoot">To add a device, open FigLock on it and choose Join my vault by pairing.</p>`, { tab: 'settings' })
};
SHEETS.device = (o) => {
  const d = S.devices.find((x) => x.id === o.dev);
  return { title: d.name, body: `<div class="group">${kv('Details', esc(d.meta))}${kv('Type', d.kind === 'phone' ? 'iPhone' : 'Computer')}</div>
    ${d.current ? `<div class="notice">${ic('info', 20)}<div>This is the iPhone you are holding. To take it off your vault, use Remove this vault from this iPhone in Settings.</div></div>` : ''}`,
    foot: `<button type="button" class="btn secondary" data-act="dev-rename" data-arg="${d.id}" data-fk="dev-rename">${ic('pencil', 20)}Rename</button>${d.current ? '' : `<button type="button" class="btn dangerplain" data-act="dev-revoke" data-arg="${d.id}" data-fk="dev-revoke">Revoke access</button>`}` };
};
ACT.device = (el, id) => openSheet('device', { dev: id });
SHEETS.rename = (o) => ({ title: 'Rename device', body: `<div class="fld"><label class="label" for="rn">Device name</label><input class="input" id="rn" data-bind="rename.val" value="${esc(o.val)}" autocomplete="off" aria-describedby="rn-e" data-autofocus><div id="rn-e"></div></div>`, foot: `<button type="button" class="btn" data-act="rn-save" data-fk="rn-save">Save name</button>` });
SHEETS.rename.onInput = (el) => { const o = S.ov[S.ov.length - 1]; o.val = el.value; $('#rn-e').innerHTML = ''; el.classList.remove('err'); };
ACT['dev-rename'] = (el, id) => closeOv(() => { const d = S.devices.find((x) => x.id === id); openSheet('rename', { dev: id, val: d.name }); });
ACT['rn-save'] = () => { const o = S.ov[S.ov.length - 1]; if (!o.val.trim()) { $('#rn-e').innerHTML = errmsg('rn-err', 'A device needs a name so you can tell it apart.'); $('#rn').classList.add('err'); $('#rn').focus(); return; } const d = S.devices.find((x) => x.id === o.dev); closeOv(() => { d.name = o.val.trim(); render(); toast(`Renamed to “${d.name}”`); }); };
ACT['dev-revoke'] = (el, id) => closeOv(() => { const d = S.devices.find((x) => x.id === id); alertDlg(`Revoke “${d.name}”?`, `${d.name} will lose access to ${S.vaultName} the next time it syncs. Items already on it can't be erased remotely.`, [cancelBtn, { label: `Revoke ${d.name}`, style: 'destructive', run: () => { S.devices = S.devices.filter((x) => x.id !== id); render(); toast(`${d.name} revoked`); } }]); });
SCREENS['secret-key'] = {
  tab: 'settings',
  render: () => frame(nav({ back: 'Settings', title: 'Secret Key', always: true }), `<h1 class="lt2" style="margin:8px 0 8px">Secret Key and Emergency Kit</h1><p class="sub">You need your Secret Key, with your password, to add a new device.</p>
    <div class="group">${secretField('seckey', 'Secret Key')}</div><p class="gfoot">It stays hidden until you choose Show. Showing it needs Face ID.</p>
    <p class="ghead">Emergency Kit</p><div class="group"><div class="cell" style="cursor:default"><span class="tile ok">${ic('shield', 20)}</span><span class="grow"><span class="t">Saved to Files</span><span class="s">Saved on Nov 12, 2026</span></span></div><div style="padding:8px 16px 12px"><button type="button" class="btn secondary" data-act="kit-save" data-fk="kit-save2">${ic('share', 20)}Save a new copy</button></div></div>
    <p class="gfoot">Anyone with your kit and your password can open your vault. Keep the kit printed or offline.</p>`, { tab: 'settings' })
};
SCREENS.about = {
  tab: 'settings',
  render: () => frame(nav({ back: 'Settings', title: 'About' }), `<div class="about-ver">${logo(72)}<h1 class="lt2">FigLock</h1><p class="hint">Version 1.0 (prototype)</p></div>
    <div class="group">${link('shield', 'How FigLock protects your data', '', 'open-link', 'Link')}${link('doc', 'Privacy policy', '', 'open-link', 'Link')}${link('text', 'Open source licenses', '', 'open-link', 'Link')}</div>
    <p class="gfoot" style="text-align:center;margin-top:16px">This screen is a design reference with made-up sample data. It is not shipped code.</p>`, { tab: 'settings' })
};

/* ================= 9 Sync setup ================= */
SCREENS['sync-setup'] = {
  tab: 'settings',
  render: () => {
    const ic1 = S.syncProvider === 'icloud', g = S.syncProvider === 'google';
    return frame(nav({ back: 'Settings', title: 'Sync', large: true }), `<h1 class="lt">Sync</h1><p class="sub">Choose where FigLock keeps the encrypted copy of your vault.</p>
      ${!S.folderOk ? `<div class="notice warn" style="margin-bottom:16px">${ic('folder', 20)}<div><b>Can't find your vault folder.</b><br>Sync is paused until you choose what to do.<br><button type="button" class="btn-sm" style="margin-top:8px" data-act="goto" data-arg="err-folder-missing" data-fk="fix-folder">See options</button></div></div>` : ''}
      ${S.driveAlert ? `<div class="notice warn" style="margin-bottom:16px">${ic('warn', 20)}<div><b>Google Drive sign-in expired.</b><br>Sync is paused until you sign in again.<br><button type="button" class="btn-sm" style="margin-top:8px" data-act="goto" data-arg="err-drive-expired" data-fk="fix-drive">Sign in again</button></div></div>` : ''}
      <div class="group" role="radiogroup" aria-label="Sync location">
        <div><button type="button" class="cell" role="radio" aria-checked="${ic1}" data-act="pick-provider" data-arg="icloud" data-fk="prov-icloud"><span class="tile">${ic('cloud', 22)}</span><span class="grow"><span class="t b">iCloud Drive folder</span><span class="s">iCloud Drive / FigLock / Mira's vault</span></span>${ic1 ? ic('check', 20, 'check') : ''}</button><div style="padding:0 16px 12px"><button type="button" class="btn-sm" data-act="goto" data-arg="icloud-picker" data-fk="chg-folder">${ic('folder', 18)}<span>Change folder</span></button></div></div>
        <div><button type="button" class="cell" role="radio" aria-checked="${g}" data-act="pick-provider" data-arg="google" data-fk="prov-google"><span class="tile">${ic('globe', 22)}</span><span class="grow"><span class="t b">Google Drive</span><span class="s">${S.driveIn ? 'Signed in as ' + ME : 'Not signed in'}</span></span>${g ? ic('check', 20, 'check') : ''}</button><div style="padding:0 16px 12px">${S.driveIn ? `<button type="button" class="btn-sm danger" data-act="drive-out" data-fk="drive-out">${ic('out', 18)}<span>Sign out of Google Drive</span></button>` : `<button type="button" class="btn-sm" data-act="goto" data-arg="drive-signin" data-fk="drive-in">${ic('person', 18)}<span>Sign in to Google Drive</span></button>`}</div></div>
      </div><p class="gfoot">FigLock uploads only the encrypted vault. Switching locations moves your vault, nothing is deleted from the old one.</p>`, { tab: 'settings' });
  }
};
ACT['pick-provider'] = (el, v) => { if (v === 'google' && !S.driveIn) { push('drive-signin'); return; } S.syncProvider = v; startSync(); toast(`Syncing with ${syncLabel()}`); };
ACT['drive-out'] = () => alertDlg('Sign out of Google Drive?', `This iPhone stops syncing with Google Drive until you sign in again. Your vault stays on this iPhone${S.syncProvider === 'google' ? ', and sync switches to iCloud Drive' : ''}.`, [cancelBtn, { label: 'Sign out', style: 'destructive', run: () => { S.driveIn = false; S.driveAlert = false; if (S.syncProvider === 'google') S.syncProvider = 'icloud'; render(); toast('Signed out of Google Drive'); } }]);
let pickFolder = 'FigLock';
SCREENS['icloud-picker'] = {
  tab: 'settings',
  render: (t) => frame(nav({ back: t.recover ? 'Options' : 'Sync', title: 'iCloud Drive folder', always: true }), `<h1 class="lt2" style="margin:8px 0 8px">Choose a folder</h1><p class="sub">FigLock hands off to the Files picker so it only gets the one folder you choose. When you tap Open, you come back here.</p>
    <div class="picker" role="group" aria-label="Illustration of the iOS Files picker"><div class="ph"><span>Cancel</span><span>iCloud Drive</span><span style="color:var(--color-text-link)">Open</span></div>
    <div class="group" style="border:0;border-radius:0" role="radiogroup" aria-label="Folders">${['FigLock', 'Documents', 'Downloads', 'Vault backup'].map((f) => `<button type="button" class="cell" role="radio" aria-checked="${pickFolder === f}" data-act="pick-folder" data-arg="${f}" data-fk="pf-${f}"><span class="tile">${ic('folder', 20)}</span><span class="grow"><span class="t">${f}</span></span>${pickFolder === f ? ic('check', 20, 'check') : ''}</button>`).join('')}</div></div>
    <p class="gfoot">Illustration of the system picker. The real one is drawn by iOS.</p>`, { foot: `<button type="button" class="btn" data-act="use-folder" data-fk="use-folder">Use “${esc(pickFolder)}”</button>` })
};
ACT['pick-folder'] = (el, f) => { pickFolder = f; render(); };
ACT['use-folder'] = () => { const rec = top().recover; S.syncProvider = 'icloud'; S.folderOk = true; if (rec) { reset('list'); } else { back(); } startSync(); toast(`Syncing with iCloud Drive / ${pickFolder}`); };
SCREENS['drive-signin'] = {
  tab: 'settings',
  render: (t) => frame(nav({ back: t.onboarding ? 'Welcome' : 'Sync', title: 'Google Drive', always: true }), `<div class="hero center" style="padding-top:24px"><span class="tile xl">${ic('cloud', 36)}</span><h1 class="lt2">Sign in to Google Drive</h1><p class="sub">FigLock keeps the encrypted vault in its own folder. It can't see anything else in your Drive.</p></div>`, { foot: `<button type="button" class="btn" data-act="g-start" data-fk="g-start">Continue with Google</button><button type="button" class="btn plain" data-act="back" data-fk="g-cancel">Not now</button>` })
};
ACT['g-start'] = () => alertDlg('“FigLock” wants to use “google.com” to sign in', 'This allows the app and website to share information about you.', [cancelBtn, { label: 'Continue', style: 'bold', run: () => openSheet('google') }]);
SHEETS.google = () => ({ title: 'Sign in with Google', body: `<p class="hint">Illustration of the Google sign-in page that opens in a secure browser sheet.</p><div class="group"><div class="cell" style="cursor:default"><span class="tile">${ic('person', 22)}</span><span class="grow"><span class="t b">Mira Okafor</span><span class="s">${ME}</span></span>${ic('check', 20, 'check')}</div></div><div class="notice">${ic('info', 20)}<div>FigLock wants access to its own folder in your Drive. It won't see your other files.</div></div>`, foot: `<button type="button" class="btn" data-act="g-allow" data-fk="g-allow">Allow</button><button type="button" class="btn plain" data-act="ov-close" data-fk="g-deny">Cancel</button>` });
ACT['g-allow'] = () => closeOv(() => {
  S.driveIn = true; S.driveAlert = false;
  if (top().onboarding) { replaceTop('drive-open'); return; }
  S.syncProvider = 'google'; back(); startSync(); toast('Signed in to Google Drive');
});
SCREENS['err-drive-expired'] = {
  tab: 'vault',
  render: () => frame(nav({ back: 'Vault', title: 'Sync paused', always: true }), `<div class="hero center" style="padding-top:32px"><span class="tile xl warn">${ic('warn', 36)}</span><h1 class="lt2">Google Drive sign-in expired</h1><p class="sub">Google needs you to sign in again before FigLock can sync. Your items are safe on this iPhone.</p></div>`, { foot: `<button type="button" class="btn" data-act="goto" data-arg="drive-signin" data-fk="re-signin">Sign in to Google Drive</button><button type="button" class="btn secondary" data-act="goto" data-arg="icloud-picker" data-fk="use-icloud">Sync with iCloud Drive instead</button>` })
};
SCREENS['err-folder-missing'] = {
  tab: 'vault',
  render: () => frame(nav({ back: 'Vault', title: 'Sync paused', always: true }), `<div class="hero center" style="padding-top:24px"><span class="tile xl warn">${ic('folder', 36)}</span><h1 class="lt2">Can't find your vault folder</h1><p class="sub">“Mira's vault” was moved or deleted in iCloud Drive, so sync is paused. Your items are safe on this iPhone.</p></div>
    <div class="stack"><button type="button" class="btn" data-act="fm-locate" data-fk="fm-locate">${ic('folder', 20)}Locate the folder</button><button type="button" class="btn secondary" data-act="fm-restore" data-fk="fm-restore">${ic('cloud', 20)}Restore from Google Drive</button><button type="button" class="btn secondary" data-act="fm-new" data-fk="fm-new">${ic('plus', 20)}Create a new vault</button></div>
    <p class="gfoot" style="margin-top:12px">Locate keeps this vault. Restore replaces it with the copy in Google Drive. Create starts empty.</p>`)
};
ACT['fm-locate'] = () => push('icloud-picker', { recover: true });
ACT['fm-restore'] = () => { if (!S.driveIn) { push('drive-signin'); return; } alertDlg('Restore from Google Drive?', "FigLock replaces the vault on this iPhone with the copy in Google Drive, last changed yesterday at 6:48 PM. Changes made since then won't be kept.", [cancelBtn, { label: 'Restore', style: 'destructive', run: () => { S.folderOk = true; S.syncProvider = 'google'; reset('list'); startSync(); toast('Restored from Google Drive'); } }]); };
ACT['fm-new'] = () => alertDlg('Create a new vault?', 'It starts empty with a new Secret Key. This vault stays on this iPhone until you remove it in Settings.', [cancelBtn, { label: 'Create new vault', style: 'bold', run: () => { S.create = freshState().create; push('create-pw'); } }]);

/* ================= 10 Agent approval ================= */
const histAdd = (text, ok) => S.history.unshift({ id: 'h' + Date.now(), agent: 'Claude Code', text, when: 'Just now', ok });
SHEETS.agent = () => {
  const r = S.req, reveal = r.mode === 'reveal';
  const end = addMin(r.mins);
  const band = `<div class="ag-band">${ic('bot', 24)}<div>Agent request<span>Drawn by FigLock, not by the agent.</span></div></div>`;
  const state = (tile, ico, h, p, foot) => ({ title: 'Agent request', tint: 'agent', body: `<div class="ag-state"><span class="tile xl ${tile}">${ic(ico, 34)}</span><h3>${h}</h3><p>${p}</p></div>`, foot });
  if (r.status === 'approved') return state('agent', 'shield', reveal ? 'Revealed to Claude Code' : 'Approved', reveal ? 'Claude Code received GitHub token once. If you did not mean to share it, replace the token on the service.' : `Claude Code can use GitHub token on api.github.com until ${end}. You can revoke it any time in Agents.`, `<button type="button" class="btn" data-act="ag-done" data-fk="ag-done">Done</button>`);
  if (r.status === 'denied') return state('', 'x', 'Denied', 'Claude Code was told no. Nothing was shared.', `<button type="button" class="btn" data-act="ag-done" data-fk="ag-done">Done</button>`);
  if (r.status === 'expired') return state('warn', 'clock', 'This request expired', 'Claude Code asked at 9:30 AM and the request closed after 10 minutes with no answer. Nothing was shared. Ask the agent to try again.', `<button type="button" class="btn" data-act="ag-done" data-fk="ag-done">Close</button>`);
  if (r.status === 'decided') return state('ok', 'okc', 'Already answered', 'Studio Mac approved this request at 9:43 AM. Another device answered first, so there is nothing left to do here.', `<button type="button" class="btn" data-act="ag-agents" data-fk="ag-view">View in Agents</button><button type="button" class="btn plain" data-act="ag-done" data-fk="ag-done">Close</button>`);
  const how = reveal
    ? `<li class="warnrow">${ic('warn', 22, 'i-warn')}<div class="q"><span class="k">How</span><span class="m">Reveal the token</span><span class="d">Claude Code gets the token itself and FigLock can't take it back. Using it earlier doesn't cover this, it needs its own approval.</span></div></li>`
    : `<li>${ic('globe', 22, 'i-agent')}<div class="q"><span class="k">How</span><span class="m">Use it through HTTP</span><span class="d">FigLock adds the token to requests the agent sends. The agent never sees it.</span></div></li>`;
  return { title: reveal ? 'Reveal request' : 'Agent request', tint: reveal ? 'warning' : 'agent', body: `${band}<ol class="ag-list">
    <li>${ic('bot', 22, 'i-agent')}<div class="q"><span class="k">Who is asking</span><span class="m">Claude Code</span><span class="d">Identified by the FigLock broker on Studio Mac: signed session, started 9:12 AM.</span></div></li>
    <li>${ic('key', 22, 'i-agent')}<div class="q"><span class="k">What</span><span class="m">GitHub token</span><span class="d">API token. Scopes: repo (read), workflow.</span></div></li>
    ${how}
    <li>${ic('globe', 22, 'i-agent')}<div class="q"><span class="k">Where</span><div class="hosts" style="margin-top:2px"><span class="host">api.github.com</span></div><span class="d">Requests to any other host are blocked.</span></div></li>
    <li>${ic('clock', 22, 'i-agent')}<div class="q"><span class="k">For how long</span><span class="m">${lenLabel(r.mins)}</span><span class="d">Ends at ${end}, or sooner if you revoke it.</span></div></li></ol>
    ${seg('Length of access', [[5, '5 min'], [15, '15 min'], [60, '1 hour']], r.mins, 'ag-mins')}`,
    foot: `<button type="button" class="btn ${reveal ? 'warn' : 'agent'}" data-act="ag-approve" data-fk="ag-approve" aria-label="${reveal ? 'Approve revealing GitHub token to Claude Code' : `Approve Claude Code to use GitHub token for ${lenLabel(r.mins)}`}, with Face ID">${ic('fingerprint', 22)}${reveal ? 'Approve reveal with Face ID' : 'Approve with Face ID'}</button><button type="button" class="btn secondary" data-act="ag-deny" data-fk="ag-deny">Deny</button>` };
};
ACT['ag-mins'] = (el, v) => { S.req.mins = Number(v); renderOv(); };
ACT['ag-approve'] = () => {
  const r = S.req, reveal = r.mode === 'reveal';
  faceId(reveal ? 'Approve revealing GitHub token to Claude Code' : `Approve Claude Code to use GitHub token for ${lenLabel(r.mins)}`, () => {
    r.status = 'approved';
    if (reveal) histAdd('Revealed GitHub token', true); else { S.grants.unshift({ id: 'g' + Date.now(), agent: 'Claude Code', item: 'GitHub token', until: `until ${addMin(r.mins)}`, mode: 'Use through HTTP' }); histAdd('Used GitHub token through HTTP', true); }
    render(); announce(reveal ? 'Approved. Token revealed once.' : 'Approved.');
  });
};
ACT['ag-deny'] = () => { S.req.status = 'denied'; histAdd(S.req.mode === 'reveal' ? 'Asked to reveal GitHub token' : 'Asked to use GitHub token', false); render(); announce('Denied. Nothing was shared.'); };
ACT['ag-done'] = () => closeOv();
ACT['ag-agents'] = () => closeOv(() => selectTab('agents'));
SCREENS['lock-notification'] = {
  render: () => `<div class="lockscr"><div class="lk-time"><span class="sr-only">Lock screen</span>${ic('lock', 20)}<span class="tm">9:41</span><span class="dt">Sunday, 22 November</span></div>
    <div><button type="button" class="notif" data-act="notif-open" data-fk="notif" aria-label="FigLock, now. Claude Code wants to use GitHub token. Open FigLock to review. Nothing is shared until you approve.">${logo(40)}<span><span class="nt"><span>FigLock</span><span>now</span></span><span class="nh" style="display:block">Claude Code wants to use GitHub token</span><span class="nb" style="display:block">Open FigLock to review this request. Nothing is shared until you approve.</span><span class="badge agent">${ic('bot', 12)}Agent request</span></span></button></div>
    <div><p class="lk-hint">Tap the notification, then unlock with Face ID</p><div class="lk-foot" aria-hidden="true"><span class="lk-btn">${ic('lock', 22)}</span><span class="lk-btn">${ic('compass', 22)}</span></div></div></div>`
};
ACT['notif-open'] = () => faceId('Unlock iPhone to review the FigLock request', () => { S.req.status = S.req.status || 'pending'; reset('list'); openSheet('agent'); });

/* ================= 11 AutoFill ================= */
const siteOf = () => (S.af.state === 'empty' ? { name: 'Example Shop', host: 'shop.example.test' } : { name: 'Cloudflare', host: 'dash.cloudflare.com' });
const AF_EXTRA = { id: 'cf2', name: 'Cloudflare', sub: 'dns-admin@example.com', user: 'dns-admin@example.com' };
const KEYS = ['q w e r t y u i o p', 'a s d f g h j k l', '⇧ z x c v b n m ⌫'];
SCREENS.safari = {
  render: () => {
    const f = S.af.filled, site = siteOf(), locked = S.af.state === 'locked', empty = S.af.state === 'empty';
    const quick = top().mode !== 'plain';
    const bar = locked ? `<button type="button" class="sugg" data-act="af-quick" data-fk="qt-sugg">${ic('lock', 18)}<span>FigLock is locked</span></button>`
      : empty ? '' : `<button type="button" class="sugg" data-act="af-quick" data-fk="qt-sugg" aria-label="Fill ${ME} from FigLock">${ic('key', 18)}<span>${ME}</span></button>`;
    return `<div class="safari"><div class="sf-page"><div class="sf-card"><h1>Sign in to ${site.name}</h1><div><div class="fl">Email</div><div class="fake ${f ? '' : 'empty'}">${f ? ME : 'name@example.com'}</div></div><div><div class="fl">Password</div><div class="fake ${f ? '' : 'focus empty'}">${f ? '<span class="sr-only">Filled, hidden</span><span aria-hidden="true">••••••••••••</span>' : 'Password'}</div></div><button type="button" class="btn" data-act="safari-go" data-fk="safari-go"${f ? '' : ' disabled'}>Sign in</button></div></div>
      ${f || !quick ? `<div class="sf-bottom"><div class="urlbar">${ic('lock', 16)}<span>${site.host}</span></div></div>` : `<div class="kb"><div class="qt" role="toolbar" aria-label="QuickType suggestions"><button type="button" data-act="af-open" data-fk="qt-keys" aria-label="Passwords from FigLock">${ic('key', 22)}</button>${bar}</div><div class="keys" aria-hidden="true">${KEYS.map((r) => `<div class="krow">${r.split(' ').map((k) => `<i class="${k === '⇧' || k === '⌫' ? 'w' : ''}">${k}</i>`).join('')}</div>`).join('')}<div class="krow"><i class="w">123</i><i class="sp">space</i><i class="w">return</i></div></div></div>`}</div>`;
  }
};
ACT['safari-go'] = () => toast('The prototype ends at the sign-in page');
ACT['af-open'] = () => openSheet('autofill');
ACT['af-quick'] = () => {
  if (S.af.state === 'locked') { faceId('Unlock FigLock to fill your password', () => { S.af.state = 'list'; openSheet('autofill'); }); return; }
  faceId('Fill your Cloudflare login in Safari', () => { S.af.filled = true; render(); toast('Filled from FigLock'); });
};
function afMatches() {
  const q = S.af.q.trim();
  if (!q) return S.af.state === 'empty' ? [] : [{ it: itemById('cloudflare'), m: { text: 'Matches domain dash.cloudflare.com' } }, { it: AF_EXTRA, m: { text: 'Matches domain dash.cloudflare.com' } }];
  return S.items.filter((i) => i.type === 'login').map((it) => ({ it, m: matchItem(it, q) })).filter((x) => x.m);
}
SHEETS.autofill = () => {
  const site = siteOf();
  if (S.af.state === 'locked') return { title: 'FigLock', body: `<div class="ag-state"><span class="tile xl">${ic('lock', 34)}</span><h3>FigLock is locked</h3><p>Unlock to see passwords for ${site.host}.</p></div>`, foot: `<button type="button" class="btn" data-act="af-unlock" data-fk="af-unlock">${ic('fingerprint', 22)}Unlock with Face ID</button>` };
  const list = afMatches(), q = S.af.q.trim();
  const rows = list.map((x) => `<button type="button" class="cell" data-act="af-pick" data-arg="${x.it.id}" data-fk="af-${x.it.id}"><span class="tile">${ic('globe', 20)}</span><span class="grow"><span class="t b od-truncate">${esc(x.it.name)}</span><span class="s od-truncate">${esc(x.it.sub)}</span>${q ? `<span class="why"><span class="badge">${ic('search', 12)}${esc(x.m.text)}</span></span>` : ''}</span>${ic('chevR', 16, 'chev')}</button>`).join('');
  const none = !list.length ? `<div class="ag-state"><span class="tile xl">${ic('search', 34)}</span><h3>${q ? `No items match “${esc(q)}”` : `No passwords for ${site.host}`}</h3><p>${q ? 'Check the spelling, or try an alias or a domain.' : 'FigLock has nothing saved for this site. Search all your items, or save a login after you sign in.'}</p></div>` : '';
  return { title: 'FigLock', body: `<p class="hint" style="margin-top:-4px">Passwords for ${site.host}</p><div class="fld"><label class="label" for="afq">Search all FigLock items</label><label class="sb-field">${ic('search', 18)}<input class="sb-in" id="afq" type="search" data-bind="af.q" value="${esc(S.af.q)}" placeholder="Name, alias or domain" autocomplete="off" spellcheck="false"></label></div>${rows ? `<div class="group">${rows}</div>` : ''}${none}` };
};
SHEETS.autofill.onInput = (el) => { if (el.id !== 'afq') return; renderOv(); const n = $('#afq'); if (n) { n.focus(); const v = n.value; n.setSelectionRange(v.length, v.length); } };
ACT['af-unlock'] = () => faceId('Unlock FigLock', () => { S.af.state = 'list'; renderOv(); });
ACT['af-pick'] = (el, id) => { const name = id === 'cf2' ? 'Cloudflare (dns-admin@example.com)' : itemById(id).name; faceId(`Fill “${name}” in Safari`, () => closeOv(() => { S.af.filled = true; S.af.q = ''; render(); toast('Filled from FigLock'); })); };

/* ================= 12 App switcher ================= */
SCREENS['app-switcher'] = {
  render: () => `<div class="switcher"><div class="cards" role="list" aria-label="Open apps">
    <div class="card" role="listitem"><div class="snap" aria-hidden="true"><i class="h"></i><i></i><i class="s"></i><i></i><i class="h"></i><i class="s"></i></div><span class="cap"><span class="minilogo" aria-hidden="true">${ic('compass', 14)}</span>Safari</span></div>
    <button type="button" class="card" role="listitem" data-act="sw-open" data-fk="sw-open" aria-label="FigLock. Content hidden for privacy. Tap to open."><div class="snap priv">${logo(64)}<strong>FigLock</strong><p>Content is hidden while the app is in the background.</p></div><span class="cap">${logo(22)}FigLock</span></button>
    <div class="card" role="listitem"><div class="snap" aria-hidden="true"><i class="s"></i><i class="h"></i><i></i><i class="s"></i><i class="h"></i></div><span class="cap"><span class="minilogo" aria-hidden="true">${ic('text', 14)}</span>Notes</span></div></div>
    <p class="sw-note">FigLock blanks its screen here, so a snapshot never shows a password, token or file name.</p></div>`,
  after: () => { const c = $('.cards'); if (c) c.scrollLeft = (c.scrollWidth - c.clientWidth) / 2; }
};
ACT['sw-open'] = () => reset('unlock');

ACT['open-link'] = () => toast('This opens in Safari in the real app');

/* ================= events ================= */
const setPath = (path, val) => { const ks = path.split('.'); let o = S; while (ks.length > 1) { const k = ks.shift(); if (typeof o[k] !== 'object' || o[k] === null) o[k] = {}; o = o[k]; } o[ks[0]] = val; };
const ownerOf = () => (S.ov.length ? SHEETS[S.ov[S.ov.length - 1].id] : SCREENS[top().id]);
const phoneEl = $('#phone');
phoneEl.addEventListener('click', (e) => {
  if (noClick) { noClick = false; e.preventDefault(); return; }
  const el = e.target.closest('[data-act]'); if (!el || el.disabled) return;
  const fn = ACT[el.dataset.act]; if (fn) fn(el, el.dataset.arg, e);
});
phoneEl.addEventListener('input', (e) => {
  const el = e.target; if (el.dataset.bind) setPath(el.dataset.bind, el.type === 'checkbox' ? el.checked : el.value);
  const o = ownerOf(); if (o && o.onInput) o.onInput(el);
});
phoneEl.addEventListener('focusout', (e) => { const el = e.target; setTimeout(() => { if (!el.isConnected) return; const o = ownerOf(); if (o && o.onBlur) o.onBlur(el); }, 0); });
phoneEl.addEventListener('focusin', (e) => {
  if (e.target.id === 'q' && !S.searching && top().id === 'list') { S.searching = true; render(); const sc = $('#main'); if (sc) sc.scrollTop = 0; const q = $('#q'); if (q) q.focus(); }
});
phoneEl.addEventListener('scroll', (e) => { if (e.target.id === 'main') { const nv = $('#nav'); if (nv) nv.classList.toggle('collapsed', e.target.scrollTop > Number(e.target.dataset.collapse || 44)); } }, true);
phoneEl.addEventListener('keydown', (e) => {
  if (S.ov.length) {
    const o = S.ov[S.ov.length - 1];
    if (e.key === 'Escape') { e.preventDefault(); if (o.type === 'faceid') ACT['fid-cancel'](); else closeOv(); return; }
    if (e.key === 'Tab') {
      const host = $('#ov').lastElementChild; const f = $$('button:not([disabled]), input:not([disabled]), textarea, [href]', host).filter((n) => n.offsetParent !== null);
      if (!f.length) return; const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); } else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  } else if (e.key === 'Enter' && e.target.id === 'pc' && S.pair.code.length === 7) ACT['pair-go']();
  else if (e.key === 'Enter' && e.target.id === 'up') ACT['un-pw']();
});
/* drag a sheet down by its grabber to dismiss */
let drag = null;
phoneEl.addEventListener('pointerdown', (e) => { const g = e.target.closest('[data-grab], .sheet-head'); if (!g || e.target.closest('button')) return; const sh = g.closest('.sheet'); if (sh) drag = { sh, y: e.clientY, d: 0 }; });
phoneEl.addEventListener('pointermove', (e) => { if (!drag) return; drag.d = Math.max(0, e.clientY - drag.y); drag.sh.style.transform = `translateY(${drag.d}px)`; });
const dragEnd = () => { if (!drag) return; const { sh, d } = drag; drag = null; if (d > 90) { sh.style.transform = ''; closeOv(); } else sh.style.transform = ''; };
phoneEl.addEventListener('pointerup', dragEnd); phoneEl.addEventListener('pointercancel', dragEnd);
ACT.back = () => back();
ACT.tab = (el, t) => selectTab(t);
wireGestures(phoneEl);
document.addEventListener('visibilitychange', () => { if (document.hidden) { S.reveal = {}; } });

/* ================= presets (screen switcher) ================= */
const PRESETS = [];
const A = (group, id, label, hint, go) => PRESETS.push({ group, id, label, hint, go });
const stack = (...entries) => { S.stack = entries.map((e) => (typeof e === 'string' ? { id: e } : e)); S.ov = []; render(); };
const WRONG = (n) => `That password isn't right. Check it and try again. ${n} ${n === 1 ? 'try' : 'tries'} left before FigLock pauses password entry.`;
const G1 = '1 Onboarding', G2 = '2 Pairing', G3 = '3 Create vault', G4 = '4 Unlock', G5 = '5 Vault list and search', G6 = '6 Item detail', G7 = '7 Edit, generator, delete', G8 = '8 Settings', G9 = '9 Sync setup and errors', G10 = '10 Agent approval', G11 = '11 AutoFill', G12 = '12 App switcher';
A(G1, 'onboarding', 'Welcome and three choices', 'Tap a choice to follow that path.', () => stack('onboarding'));
A(G1, 'drive-open', 'Open vault from Google Drive', 'Secret Key and password are prefilled with sample values.', () => { S.driveIn = true; stack('onboarding', 'drive-open'); });
A(G2, 'pair-scan', 'Scan the pairing code', 'Tap the viewfinder to simulate a scan.', () => stack('onboarding', 'pair-scan'));
A(G2, 'pair-enter', 'Enter the pairing code', 'Type a 6 character code such as K7M2QX. It auto-formats.', () => { S.pair.tab = 'enter'; stack('onboarding', 'pair-scan'); });
A(G2, 'pair-enter-error', 'Enter code: too short', 'Error appears on blur and says how to fix it.', () => { S.pair.tab = 'enter'; S.pair.code = 'K7M'; S.pair.err = 'That code is too short. It has six letters and numbers, like K7M-2QX.'; stack('onboarding', 'pair-scan'); });
A(G2, 'pair-wait', 'Waiting for approval', 'Normally moves on by itself after a few seconds. Held here for review.', () => { S.pair.hold = true; stack('onboarding', 'pair-scan', 'pair-wait'); });
A(G2, 'pair-declined', 'Pairing declined', 'The other device chose Deny.', () => { S.pair.declined = true; stack('onboarding', 'pair-scan', 'pair-wait'); });
A(G2, 'pair-done', 'Paired: success', 'Face ID can be switched on here.', () => stack('pair-done'));
A(G3, 'create-pw', 'Password', 'Needs 12 or more characters. Type different text in the two fields to see the mismatch error.', () => stack('onboarding', 'create-pw'));
A(G3, 'create-key', 'Secret Key, shown once', 'Hidden until you choose Show.', () => stack('onboarding', 'create-pw', 'create-key'));
A(G3, 'create-kit', 'Save Emergency Kit', 'Save to Files, Print or AirDrop all mark it saved.', () => stack('onboarding', 'create-pw', 'create-key', 'create-kit'));
A(G3, 'create-kit-saved', 'Emergency Kit saved', '', () => { S.create.kitSaved = true; stack('onboarding', 'create-pw', 'create-key', 'create-kit'); });
A(G3, 'create-verify', 'Verify: re-enter last group', 'The last group of the sample Secret Key is STUV.', () => stack('onboarding', 'create-pw', 'create-key', 'create-kit', 'create-verify'));
A(G3, 'create-verify-error', 'Verify: wrong group', '', () => { S.create.verify = 'ABCD'; S.create.err = "That doesn't match the last group of your Secret Key. Check your saved Emergency Kit and try again."; stack('onboarding', 'create-pw', 'create-key', 'create-kit', 'create-verify'); });
A(G4, 'unlock', 'Face ID primary', 'Tap Unlock with Face ID. Use the Face ID result control to see a failure.', () => stack('unlock'));
A(G4, 'unlock-pw', 'Password fallback', 'The sample password is sample-vault-pass.', () => { S.unlock.pw = true; stack('unlock'); });
A(G4, 'unlock-wrong', 'Wrong password error', 'Type anything but the sample password.', () => { S.unlock = { fails: 1, pw: true, err: WRONG(2) }; stack('unlock'); });
A(G4, 'unlock-locked', 'Locked out after failures', 'Password entry is paused. Face ID still works.', () => { S.unlock = { fails: 3, pw: true, err: '' }; stack('unlock'); });
A(G5, 'list', 'Vault list, synced', 'Pull down for search. Swipe a row left, or press and hold or right click it, for actions.', () => stack('list'));
A(G5, 'list-search-typo', 'Search: typo-corrected', 'Search never shows secret values. It says why each item matched.', () => { S.q = 'githb'; S.searching = true; stack('list'); });
A(G5, 'list-search-alias', 'Search: alias match', '', () => { S.q = 'gh'; S.searching = true; stack('list'); });
A(G5, 'list-search-none', 'Search: no results', '', () => { S.q = 'zzzq'; S.searching = true; stack('list'); });
A(G5, 'list-syncing', 'Sync chip: syncing', '', () => { S.sync = 'syncing'; stack('list'); });
A(G5, 'list-notsynced', 'Sync chip: not synced', 'Tap the chip for details and actions.', () => { S.sync = 'notsynced'; stack('list'); });
A(G5, 'list-offline', 'Sync chip: offline', '', () => { S.sync = 'offline'; stack('list'); });
A(G5, 'list-empty', 'Empty vault', '', () => { S.items = []; stack('list'); });
A(G5, 'list-sync-sheet', 'Sync status sheet', 'Drag the grabber down to dismiss.', () => { S.sync = 'notsynced'; stack('list'); openSheet('sync-status'); });
A(G6, 'detail-login', 'Login item', 'Show asks for Face ID, reveals for 10 s, then hides again. Copy says it clears in 30 s.', () => stack('list', { id: 'detail', item: 'cloudflare' }));
A(G6, 'detail-token', 'API token item', 'Teal marks agent access.', () => stack('list', { id: 'detail', item: 'github' }));
A(G6, 'detail-doc', 'Document item (.p12)', '', () => stack('list', { id: 'detail', item: 'signing' }));
A(G6, 'detail-revealed', 'Token revealed (10 s)', 'It hides again by itself in 10 seconds.', () => { S.reveal['github:secret'] = Date.now() + 10000; stack('list', { id: 'detail', item: 'github' }); });
A(G6, 'detail-copied', 'Token copied (30 s)', '', () => { S.copied = { key: 'github:secret', until: Date.now() + 30000 }; stack('list', { id: 'detail', item: 'github' }); });
A(G6, 'detail-faceid', 'Face ID sheet for Show', 'Switch the Face ID result control to Fails to see the fallback.', () => { stack('list', { id: 'detail', item: 'github' }); ACT.reveal(null, 'github:secret'); });
A(G7, 'edit-login', 'Edit a login', 'Clear the name and leave the field to see the error.', () => { stack('list', { id: 'detail', item: 'cloudflare' }); openEdit('cloudflare'); });
A(G7, 'edit-new-token', 'New API token', '', () => { stack('list'); openEdit(null, 'token'); });
A(G7, 'generator', 'Password generator sheet', 'Change length and options. Use this password fills the field.', () => { stack('list', { id: 'detail', item: 'cloudflare' }); openEdit('cloudflare'); regen(); openSheet('generator'); });
A(G7, 'delete-confirm', 'Delete confirm', 'The dialog names the item and says what happens.', () => { stack('list', { id: 'detail', item: 'linear' }); confirmDelete('linear'); });
A(G7, 'recently-deleted', 'Recently deleted', 'Restore brings an item back.', () => stack('list', 'deleted'));
A(G7, 'recently-deleted-empty', 'Recently deleted: empty', '', () => { S.deleted = []; stack('list', 'deleted'); });
A(G8, 'settings', 'Settings', '', () => { S.stack = [{ id: 'settings' }]; S.stack[0].scroll = 0; render(); });
A(G8, 'autolock', 'Auto-lock timeout', '', () => stack('settings', 'autolock'));
A(G8, 'devices', 'Devices list', 'Tap a device to rename or revoke.', () => stack('settings', 'devices'));
A(G8, 'device-sheet', 'Device sheet', '', () => { stack('settings', 'devices'); openSheet('device', { dev: 'work' }); });
A(G8, 'device-rename', 'Rename device', 'Clear the field and tap Save to see the error.', () => { stack('settings', 'devices'); openSheet('rename', { dev: 'work', val: 'Work laptop' }); });
A(G8, 'device-revoke', 'Revoke device confirm', '', () => { stack('settings', 'devices'); ACT['dev-revoke'](null, 'work'); });
A(G8, 'secret-key', 'Secret Key and Emergency Kit', 'Show needs Face ID.', () => stack('settings', 'secret-key'));
A(G8, 'remove-vault', 'Remove vault from this iPhone', '', () => { stack('settings'); ACT['remove-vault'](); });
A(G8, 'about', 'About', '', () => stack('settings', 'about'));
A(G9, 'sync-setup', 'Sync: choose location', 'iCloud Drive folder and Google Drive, with sign in and sign out.', () => stack('settings', 'sync-setup'));
A(G9, 'drive-signout', 'Google Drive sign out confirm', '', () => { stack('settings', 'sync-setup'); ACT['drive-out'](); });
A(G9, 'icloud-picker', 'iCloud Drive folder picker', 'Illustrates the hand-off to the iOS Files picker.', () => stack('settings', 'sync-setup', 'icloud-picker'));
A(G9, 'drive-signin', 'Google Drive sign in', 'The system asks before opening the Google sign-in page.', () => { S.driveIn = false; stack('settings', 'sync-setup', 'drive-signin'); });
A(G9, 'err-drive-expired', 'Error: Drive sign-in expired', '', () => { S.driveAlert = true; S.syncProvider = 'google'; S.sync = 'notsynced'; stack('list', 'err-drive-expired'); });
A(G9, 'err-folder-missing', 'Error: folder missing, recovery', 'Three ways forward.', () => { S.folderOk = false; S.sync = 'notsynced'; stack('list', 'err-folder-missing'); });
A(G9, 'list-sync-banner', 'Vault list with sync warning', '', () => { S.driveAlert = true; S.sync = 'notsynced'; stack('list'); });
A(G10, 'lock-notification', 'Lock screen banner', 'Tap the banner, then Face ID.', () => stack('lock-notification'));
A(G10, 'agent-sheet', 'Approval sheet', 'Order: who, what, how, where, for how long, then Approve with Face ID or Deny. Swipe it away to decide later.', () => { stack('list'); openSheet('agent'); });
A(G10, 'agent-reveal', 'Approval sheet: Reveal', 'Warning styling, needs its own approval.', () => { S.req.mode = 'reveal'; stack('list'); openSheet('agent'); });
A(G10, 'agent-approved', 'Approved', '', () => { S.req.status = 'approved'; stack('list'); openSheet('agent'); });
A(G10, 'agent-denied', 'Denied', '', () => { S.req.status = 'denied'; stack('list'); openSheet('agent'); });
A(G10, 'agent-expired', 'Expired request', '', () => { S.req.status = 'expired'; stack('list'); openSheet('agent'); });
A(G10, 'agent-decided', 'Already decided elsewhere', '', () => { S.req.status = 'decided'; stack('list'); openSheet('agent'); });
A(G10, 'agents-tab', 'Agents tab', 'Pending request, active grants and history.', () => stack('agents'));
A(G11, 'af-quicktype', 'Safari login with QuickType', 'Tap the FigLock suggestion to fill, or the key button for the full list.', () => stack('safari'));
A(G11, 'af-list', 'AutoFill list', 'Matching accounts for the site, plus search.', () => { stack('safari'); openSheet('autofill'); });
A(G11, 'af-search', 'AutoFill search', '', () => { S.af.q = 'lin'; stack('safari'); openSheet('autofill'); });
A(G11, 'af-locked', 'AutoFill: FigLock is locked', 'Unlock with Face ID, then pick an account.', () => { S.af.state = 'locked'; stack('safari'); openSheet('autofill'); });
A(G11, 'af-empty', 'AutoFill: no matches', '', () => { S.af.state = 'empty'; stack('safari'); openSheet('autofill'); });
A(G11, 'af-filled', 'Filled after AutoFill', '', () => { S.af.filled = true; stack('safari'); });
A(G12, 'app-switcher', 'Blanked privacy screen', 'Tap the FigLock card to return to the lock screen.', () => stack('app-switcher'));

function applyPreset(id) {
  const p = PRESETS.find((x) => x.id === id) || PRESETS[0];
  const keep = { theme: S.theme, dt: S.dt, rm: S.rm, faceOk: S.faceOk };
  Object.keys(S).forEach((k) => delete S[k]); Object.assign(S, freshState(), keep, { toast: null });
  clearTimeout(pairTimer); clearTimeout(syncT); closing = false; lastTop = null; $('#toast').innerHTML = '';
  S.preset = p.id; S.hint = p.hint; p.go();
}
function syncPanel() {
  const cur = $('#pcur'); if (cur) cur.textContent = `Now showing: ${top().id}`;
  const h = $('#phint'); if (h) h.innerHTML = S.hint ? `<strong>Try this</strong><p style="margin-top:4px">${esc(S.hint)}</p>` : '<strong>Try this</strong><p style="margin-top:4px">Tap through the app, or jump to any screen with the list above.</p>';
  $$('[data-p]').forEach((b) => { const k = b.dataset.p, v = b.dataset.v; const on = k === 'theme' ? S.theme === v : k === 'dt' ? S.dt === v : k === 'face' ? (S.faceOk ? 'ok' : 'fail') === v : (S.rm ? 'on' : 'off') === v; b.setAttribute('aria-pressed', on); });
  const s = $('#sw'); if (s && S.preset && s.value !== S.preset) s.value = S.preset;
}
(function initPanel() {
  const sel = $('#sw'); let g = null, og = null;
  PRESETS.forEach((p) => { if (p.group !== g) { g = p.group; og = document.createElement('optgroup'); og.label = g; sel.appendChild(og); } const o = document.createElement('option'); o.value = p.id; o.textContent = p.label; og.appendChild(o); });
  sel.addEventListener('change', () => applyPreset(sel.value));
  const step = (d) => { const i = PRESETS.findIndex((p) => p.id === S.preset); const n = PRESETS[(i + d + PRESETS.length) % PRESETS.length]; sel.value = n.id; applyPreset(n.id); };
  $('#sw-prev').addEventListener('click', () => step(-1)); $('#sw-next').addEventListener('click', () => step(1));
  $$('[data-p]').forEach((b) => b.addEventListener('click', () => { const k = b.dataset.p, v = b.dataset.v; if (k === 'theme') S.theme = v; if (k === 'dt') S.dt = v; if (k === 'face') S.faceOk = v === 'ok'; if (k === 'rm') S.rm = v === 'on'; render(); }));
  $('#p-reset').addEventListener('click', () => applyPreset(S.preset || 'onboarding'));
  const dm = matchMedia('(prefers-color-scheme: dark)'); if (dm.matches) S.theme = 'dark';
  applyPreset('onboarding'); sel.value = 'onboarding';
})();

</script>
</body>
</html>
