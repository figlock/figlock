class Figlock < Formula
  desc "Headless, agent-aware password manager"
  homepage "https://figlock.com"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    url "https://github.com/figlock/figlock/releases/download/v@VERSION@/figlock-@VERSION@-universal-apple-darwin.tar.gz"
    sha256 "@SHA_MACOS@"
  end

  on_linux do
    on_intel do
      url "https://github.com/figlock/figlock/releases/download/v@VERSION@/figlock-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_X86_64@"
    end
    on_arm do
      url "https://github.com/figlock/figlock/releases/download/v@VERSION@/figlock-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_AARCH64@"
    end
  end

  def install
    bin.install "figlock"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/figlock --version")
  end
end
